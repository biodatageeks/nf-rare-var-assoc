            enabled: params.publish_intermediate,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'PLINK2_PROJECTION_SCORE' {
        publishDir = [
            path: { "${params.outdir}/plink2_projection_score" },
            mode: params.publish_dir_mode,
