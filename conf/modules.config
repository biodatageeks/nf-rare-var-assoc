    withName: 'BCFTOOLS_VIEW_AND_FILTER2' {
        publishDir = [
            path: { "${params.outdir}/bcftools_view_and_filter2" },
            mode: params.publish_dir_mode,
            enabled: params.publish_intermediate,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
        ext.args = '--output-type z --write-index=tbi'
    }

    withName: 'BCFTOOLS_INDEX' {
        publishDir = [
            path: { "${params.outdir}/bcftools_index" },
            mode: params.publish_dir_mode,
