/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Benchmark Configuration
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Configuration for comparing R vs bcftools vs Python implementations
    of vcf2aaf and assign_annotations processes
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

params {
    publish_intermediate = true
    publish_dir_mode = 'copy'

    // Output directory for benchmark results
    outdir = 'benchmark_results'
    
    // VCF2AAF parameters
    vcf2aaf_tag_name = 'AF_nfe_gnomad'
    vcf2aaf_default_tag = 'AF'
    
    // Assign annotations parameters
    // Supports both underscore and hyphen formats (e.g., --min_top_annotations or --min-top-annotations)
    // --include-intergenic takes TRUE/FALSE value
    annotate_options = '--min_top_annotations 30 --max_annotations 62 --quantile_threshold 0.25 --include-intergenic FALSE'
}

// Process-specific configurations with generous resources for benchmarking
process {
    // Default error strategy
    errorStrategy = 'terminate'
    
    publishDir = [
        path: { "${params.outdir}/${task.process.tokenize(':')[-1].toLowerCase()}" },
        mode: 'copy',
        enabled: true
    ]

    // Configure BCFTOOLS_INDEX to produce .tbi files
    withName: 'BCFTOOLS_INDEX' {
        ext.args = '--tbi'
    }
    
    // Override publishDir for R scripts to ensure they publish during benchmarking
    withName: 'RSCRIPT_VCFTOAAF' {
        publishDir = [
            path: { "${params.outdir}/rscript_vcftoaaf" },
            mode: 'copy',
            enabled: true,
            saveAs: { filename -> filename }  // Include all files including .command.log
        ]
    }
    
    withName: 'RSCRIPT_ASSIGN_ANNOTATIONS' {
        publishDir = [
            path: { "${params.outdir}/rscript_assign_annotations" },
            mode: 'copy',
            enabled: true,
            saveAs: { filename -> filename }  // Include all files including .command.log
        ]
    }
    
    withName: 'BCFTOOLS_ASSIGN_ANNOTATIONS' {
        publishDir = [
            path: { "${params.outdir}/bcftools_assign_annotations" },
            mode: 'copy',
            enabled: true,
            saveAs: { filename -> filename }
        ]
    }
    
    withName: 'BCFTOOLS_ASSIGN_ANNOTATIONS_SHELL' {
        publishDir = [
            path: { "${params.outdir}/bcftools_assign_annotations_shell" },
            mode: 'copy',
            enabled: true,
            saveAs: { filename -> filename }
        ]
    }
    
    // Memory settings - generous for R processes
    withLabel: 'process_low' {
        cpus = 1
        memory = '4.GB'
        time = '1.h'
    }
    
    withLabel: 'process_medium' {
        cpus = 2
        memory = '8.GB'
        time = '4.h'
    }
    
    withLabel: 'process_medium_memory' {
        cpus = 2
        memory = '32.GB'  // R scripts may need lots of memory
        time = '8.h'
    }
    
    withLabel: 'process_high' {
        cpus = 4
        memory = '50.GB'
        time = '12.h'
    }
}

// Profiles for different test scenarios
profiles {
    // Test with small VEP-annotated data (17 MB VCF)
    test_small {
        params {
            input_vcf = "${projectDir}/../assets/test_sim_chr22_vep.vcf.gz"
            outdir = 'benchmark_results_small'
        }
    }
    
    // Test with large VEP-annotated data (1.8 GB VCF)
    test_large {
        params {
            input_vcf = "${projectDir}/../assets/prepare_vep_medium.vcf.gz"
            outdir = 'benchmark_results_large'
        }
        
        // More resources for large file
        process {
            withLabel: 'process_medium_memory' {
                memory = '50.GB'
                time = '24.h'
            }
        }
    }
    
    // Run both tests
    test_both {
        params {
            input_vcf = [
                "${projectDir}/../assets/test_sim_chr22_vep.vcf.gz",
                "${projectDir}/../assets/prepare_vep_medium.vcf.gz"
            ]
            outdir = 'benchmark_results_both'
        }
        
        process {
            withLabel: 'process_medium_memory' {
                memory = '50.GB'
                time = '24.h'
            }
        }
    }
    
    // Docker profile
    docker {
        docker.enabled = true
        docker.userEmulation = true
        podman.enabled          = false
        conda.enabled           = false
        singularity.enabled     = false
        shifter.enabled         = false
        charliecloud.enabled    = false
        apptainer.enabled       = false
    }

    podman {
        podman.enabled          = true
        conda.enabled           = false
        docker.enabled          = false
        singularity.enabled     = false
        shifter.enabled         = false
        charliecloud.enabled    = false
        apptainer.enabled       = false
        podman.mountFlags       = 'z'
    }
    
    // Singularity profile
    singularity {
        singularity.enabled = true
        singularity.autoMounts = true
        docker.enabled = false
    }
    
    // Conda profile
    conda {
        conda.enabled = true
        docker.enabled = false
        singularity.enabled = false
    }
    
    // Local execution (for testing)
    local {
        executor.name = 'local'
        executor.cpus = 8
        executor.memory = '50.GB'
    }
}

// Timeline, report, and trace for performance analysis
timeline {
    enabled = true
    file = "${params.outdir}/pipeline_info/benchmark_timeline.html"
    overwrite = true
}

report {
    enabled = true
    file = "${params.outdir}/pipeline_info/benchmark_report.html"
    overwrite = true
}

trace {
    enabled = true
    file = "${params.outdir}/pipeline_info/benchmark_trace.txt"
    overwrite = true
    fields = 'task_id,hash,native_id,process,tag,name,status,exit,module,container,cpus,time,disk,memory,attempt,submit,start,complete,duration,realtime,queue,%cpu,%mem,rss,vmem,peak_rss,peak_vmem,rchar,wchar,syscr,syscw,read_bytes,write_bytes,vol_ctxt,inv_ctxt,env,workdir,script,scratch,error_action'
}

dag {
    enabled = true
    file = "${params.outdir}/pipeline_info/benchmark_dag.html"
    overwrite = true
}

// Manifest
manifest {
    name = 'benchmark_implementations'
    author = 'Benchmark Script'
    description = 'Benchmark comparing R vs bcftools vs Python implementations'
    version = '1.0.0'
    nextflowVersion = '>=23.04.0'
}
