/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    psuszyns/rare-var-assoc-nf Nextflow base config file
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    A 'blank slate' config file, appropriate for general use on most high performance
    compute environments. Assumes that all software is installed and available on
    the PATH. Runs in `local` mode - all jobs will be run on the logged in environment.
----------------------------------------------------------------------------------------
*/

workflow.failOnIgnore = true

process {

    cpus   = { 2      * task.attempt }
    memory = { 8.GB   * task.attempt }
    time   = { 4.h    * task.attempt }

    errorStrategy = {
        if (params['errorStrategy']) {
            if (params.errorStrategy == 'retryThenIgnore') {
                if (task.attempt <= 1) {
                    return 'retry'
                } else {
                    return 'ignore'
                }
            }
            return params.errorStrategy
        } else {
            if (task.exitStatus in ((130..145) + 104)) {
                return 'retry'
            } else {
                return 'finish'
            }
        }
    }
    maxErrors     = 20

    withLabel:process_1 {
        cpus   = { 2     * task.attempt }
        memory = { 8.GB * task.attempt }
        time   = { 4.h   * task.attempt }
    }
    withLabel:process_2 {
        cpus   = { 4    * task.attempt }
        memory = { 16.GB * task.attempt }
        time   = { 8.h   * task.attempt }
    }
    withLabel:process_4 {
        cpus   = { 16    * task.attempt }
        memory = { 60.GB * task.attempt }
        time   = { 16.h  * task.attempt }
    }
    withLabel:process_long {
        time   = { 20.h  * task.attempt }
    }
    withLabel:process_6 {
        memory = { 60.GB * task.attempt }
        time   = { 8.h   * task.attempt }
    }
    withLabel:process_9 {
        memory = { 60.GB * task.attempt }
        time   = { 16.h  * task.attempt }
    }
    withLabel:error_ignore {
        errorStrategy = 'ignore'
    }
    withLabel:error_retry {
        errorStrategy = 'retry'
        maxErrors     = 5
    }
}

