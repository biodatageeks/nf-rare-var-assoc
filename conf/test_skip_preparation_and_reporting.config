/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running minimal tests
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Defines input files and everything required to run a fast and simple pipeline test.

    Use as follows:
        nextflow run psuszyns/rare-var-assoc-nf -profile test,<docker/singularity> --outdir <OUTDIR>

----------------------------------------------------------------------------------------
*/

process {
    resourceLimits = [
        cpus: 4,
        memory: '15.GB',
        time: '6.h'
    ]
}

params {
    config_profile_name        = 'Test profile'
    config_profile_description = 'Minimal test dataset to check pipeline function'

    //inbreeding_outliers_range_stds   = 6

    //plink2_makebed_options_3        = '--geno 0.1 --hwe 1e-13 0.001 --mac 20 --maf 0.01'
    //plink2_write_snplist_qc_options = '--mind 0.1'

    filter_vcf_qual_min       = "15"
    filter_vcf_avg_gq_min     = "15"
    filter_vcf_avg_dp_min     = "15"
    filter_vcf_avg_dp_max     = "200"
    filter_vcf_sample_gq_min  = "10"
    filter_vcf_sample_dp_min  = "10"
    filter_vcf_sample_dp_max  = "250"
    
    rscript_vcf2aaf_options         = 'AF AF'

    //regenie_step1_options           = '--minCaseCount 1 --minMAC 1 --bt --bsize 100 --lowmem'

    //regenie_step2_options           = '--minCaseCount 1 --minMAC 1 --bt --ref-first --firth --approx --bsize 200 --lowmem --aaf-bins 0.01,0.05,0.1,1 --write-mask --write-mask-snplist --vc-tests skato'

    
    // Input data
    input_vcf  = "${projectDir}/assets/medium_data/prepared_chr_12_22_X_csq_filtered_2k_rand_3k.vcf.gz"
    input_controls = "${projectDir}/assets/medium_data/1kGP_controls_400.txt"
    input_cases = "${projectDir}/assets/medium_data/1kGP_cases_200.txt"
    project_name = "test_skip_preparation_and_reporting"
    outdir = "results_test_skip_preparation_and_reporting"

    use_dosage                       = true
    skip_preparation                 = true
    skip_reporting                   = true
}
