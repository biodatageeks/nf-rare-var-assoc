nextflow_workflow {

    name "RARE_VAR_ASSOC skip-preparation skip-reporting smoke"
    script "main.nf"
    workflow "PSUSZYNS_RARE_VAR_ASSOC"

    tag "workflows"
    tag "smoke"
    tag "skip_preparation"
    tag "skip_reporting"

    // NOTE:
    // This is a template. Convert to *.nf.test when fixture and output assertions are finalized.
    // Scenario coverage: S11

    test("S11 branch smoke") {

        when {
            params {
                input_vcf = "${projectDir}/assets/medium_data/prepared_chr_12_22_X_csq_filtered_2k_rand_3k.vcf.gz"
                input_cases = "${projectDir}/assets/medium_data/1kGP_cases_200.txt"
                input_controls = "${projectDir}/assets/medium_data/1kGP_controls_400.txt"
                skip_preparation = true
                skip_reporting = true
                use_dosage = true
                outdir = "${projectDir}/tests/workflows/expected/s11_smoke"
                project_name = "smoke_s11"
            }
        }

        then {
            assertAll(
                { assert true }
            )
        }
    }
}
