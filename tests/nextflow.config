/*
========================================================================================
    Nextflow config file for running tests
========================================================================================
*/

process {
    resourceLimits = [
        cpus: 4,
        memory: '15.GB',
        time: '6.h'
    ]
}

params {
    config_profile_name        = 'Workflow semantic tests profile'
    config_profile_description = 'Baseline parameters for workflow-level semantic and smoke tests'

    // Keep thresholds permissive enough for deterministic test fixtures.
    filter_and_enhance_vcf_qual_min       = "15"
    filter_and_enhance_vcf_avg_gq_min     = "15"
    filter_and_enhance_vcf_avg_dp_min     = "15"
    filter_and_enhance_vcf_avg_dp_max     = "200"
    filter_and_enhance_vcf_sample_gq_min  = "10"
    filter_and_enhance_vcf_sample_dp_min  = "10"
    filter_and_enhance_vcf_sample_dp_max  = "250"

    rscript_vcf2aaf_options = 'AF AF'

    // Defaults here target skip_preparation / skip_reporting branch used by this design doc.
    use_dosage       = true
    skip_preparation = true
    skip_reporting   = true

    // Baseline input data; scenario-specific tests can override these params.
    input_vcf      = "${projectDir}/assets/medium_data/prepared_chr_12_22_X_csq_filtered_2k_rand_3k.vcf.gz"
    input_controls = "${projectDir}/assets/medium_data/1kGP_controls_400.txt"
    input_cases    = "${projectDir}/assets/medium_data/1kGP_cases_200.txt"

    project_name = "workflow_semantic_tests"
    outdir       = "results_tests_workflow_semantic"
}
