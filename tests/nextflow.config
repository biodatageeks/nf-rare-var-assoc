/*
========================================================================================
    Default nf-test config (referenced as configFile in the repo-root nf-test.config).
    Workflow-level params, when needed, are set per-scenario in a sibling
    nextflow.config next to each .nf.test file.
========================================================================================
*/

process {
    resourceLimits = [
        cpus: 4,
        memory: '15.GB',
        time: '6.h'
    ]
}
