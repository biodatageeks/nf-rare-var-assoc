/*
========================================================================================
    Nextflow config file for running tests
========================================================================================
*/

process {
    resourceLimits = [
        cpus: 4,
        memory: '15.GB',
        time: '1.h'
    ]
}

params {
    plink2_write_snplist_options    = '--mac 1'
    plink2_write_snplist_qc_options = '--maf 0.01 --mac 1 --geno 0.1 --hwe 1e-15 --write-samples'

    rscript_annotate_options        = '5'
    rscript_vcf2aaf_options         = 'AF_EUR AF'  // 'GNOMADAF swegenAF'

    regenie_step1_options           = '--minCaseCount 1 --minMAC 1 --bt --bsize 100 --lowmem'

    regenie_step2_options           = '--minCaseCount 1 --minMAC 1 --bt --ref-first --firth --approx --bsize 200 --lowmem --aaf-bins 0.01,0.05,0.1,1 --write-mask --write-mask-snplist --vc-tests skato'


    // Input data
    // TODO nf-core: Specify the paths to your test data on nf-core/test-datasets
    // TODO nf-core: Give any required params for the test so that command line flags are not needed
    input_vcf  = "${projectDir}/assets/medium_data/1kGP.chr22.panel_head100k_exome_vep.vcf"
    input_controls = "${projectDir}/assets/medium_data/1kGP_controls.txt"
    input_cases = "${projectDir}/assets/medium_data/1kGP_cases.txt"
}
