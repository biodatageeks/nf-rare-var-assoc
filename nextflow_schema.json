{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://raw.githubusercontent.com/psuszyns/rare-var-assoc-nf/master/nextflow_schema.json",
    "title": "psuszyns/rare-var-assoc-nf pipeline parameters",
    "description": "Rare variant association study using Regenie",
    "type": "object",
    "$defs": {
        "input_output_options": {
            "title": "Input/output options",
            "type": "object",
            "fa_icon": "fas fa-terminal",
            "description": "Define where the pipeline should find input data and save output data.",
            "required": ["input_vcf", "outdir"],
            "properties": {
                "input_vcf": {
                    "type": "string",
                    "format": "file-path",
                    "exists": true,
                    "mimetype": "text/tab-separated-values",
                    "pattern": "^\\S+\\.vcf(\\.gz){0,1}$",
                    "description": "Path to the VCF file.",
                    "fa_icon": "fas fa-file-plus-minus"
                },
                "input_controls": {
                    "type": "string",
                    "format": "file-path",
                    "exists": true,
                    "mimetype": "text/tab-separated-values",
                    "description": "Path to the controls file.",
                    "fa_icon": "fas fa-briefcase-blank"
                },
                "input_cases": {
                    "type": "string",
                    "format": "file-path",
                    "exists": true,
                    "mimetype": "text/tab-separated-values",
                    "description": "Path to the cases file.",
                    "fa_icon": "fas fa-briefcase-medical"
                },
                "input_phenotype": {
                    "type": "string",
                    "description": "Path to the phenotype file.",
                    "fa_icon": "fas fa-briefcase-medical"
                },
                "input_masks": {
                    "type": "string",
                    "format": "file-path",
                    "exists": true,
                    "mimetype": "text/tab-separated-values",
                    "description": "Path to the masks file.",
                    "fa_icon": "fas fa-briefcase-medical"
                },
                "project_name": {
                    "type": "string",
                    "description": "Project name.",
                    "fa_icon": "fas fa-file-signature"
                },
                "outdir": {
                    "type": "string",
                    "format": "directory-path",
                    "description": "The output directory where the results will be saved. You have to use absolute paths to storage on Cloud infrastructure.",
                    "fa_icon": "fas fa-folder-open"
                },
                "multiqc_title": {
                    "type": "string",
                    "description": "MultiQC report title. Printed as page header, used for filename if not otherwise specified.",
                    "fa_icon": "fas fa-file-signature"
                }
            }
        },
        "institutional_config_options": {
            "title": "Institutional config options",
            "type": "object",
            "fa_icon": "fas fa-university",
            "description": "Parameters used to describe centralised config profiles. These should not be edited.",
            "help_text": "The centralised nf-core configuration profiles use a handful of pipeline parameters to describe themselves. This information is then printed to the Nextflow log when you run a pipeline. You should not need to change these values when you run a pipeline.",
            "properties": {
                "custom_config_version": {
                    "type": "string",
                    "description": "Git commit id for Institutional configs.",
                    "default": "master",
                    "hidden": true,
                    "fa_icon": "fas fa-users-cog"
                },
                "custom_config_base": {
                    "type": "string",
                    "description": "Base directory for Institutional configs.",
                    "default": "https://raw.githubusercontent.com/nf-core/configs/master",
                    "hidden": true,
                    "help_text": "If you're running offline, Nextflow will not be able to fetch the institutional config files from the internet. If you don't need them, then this is not a problem. If you do need them, you should download the files from the repo and tell Nextflow where to find them with this parameter.",
                    "fa_icon": "fas fa-users-cog"
                },
                "config_profile_name": {
                    "type": "string",
                    "description": "Institutional config name.",
                    "hidden": true,
                    "fa_icon": "fas fa-users-cog"
                },
                "config_profile_description": {
                    "type": "string",
                    "description": "Institutional config description.",
                    "hidden": true,
                    "fa_icon": "fas fa-users-cog"
                },
                "config_profile_contact": {
                    "type": "string",
                    "description": "Institutional config contact information.",
                    "hidden": true,
                    "fa_icon": "fas fa-users-cog"
                },
                "config_profile_url": {
                    "type": "string",
                    "description": "Institutional config URL link.",
                    "hidden": true,
                    "fa_icon": "fas fa-users-cog"
                }
            }
        },
        "pipeline_options": {
            "title": "Pipeline options",
            "type": "object",
            "fa_icon": "fas fa-cogs",
            "description": "Pipeline behaviour flags.",
            "properties": {
                "skip_preparation": {
                    "type": "boolean",
                    "default": false,
                    "description": "Skip VCF preparation subworkflow (assumes input is already prepared)",
                    "fa_icon": "fas fa-forward"
                },
                "skip_reporting": {
                    "type": "boolean",
                    "default": false,
                    "description": "Skip HTML report generation",
                    "fa_icon": "fas fa-forward"
                },
                "use_dosage": {
                    "type": "boolean",
                    "default": false,
                    "description": "Use dosage (DS field) instead of hard genotype calls in Regenie",
                    "fa_icon": "fas fa-dna"
                },
                "publish_intermediate": {
                    "type": "boolean",
                    "default": false,
                    "description": "Publish intermediate files to outdir",
                    "fa_icon": "fas fa-folder-open"
                },
                "regenie_step1_kinship_filtering": {
                    "type": "boolean",
                    "default": false,
                    "description": "Enable kinship-based sample filtering in Regenie step 1",
                    "fa_icon": "fas fa-dna"
                },
                "tmpdir": {
                    "type": "string",
                    "description": "Temporary directory override",
                    "fa_icon": "fas fa-folder"
                },
                "errorStrategy": {
                    "type": "string",
                    "description": "Override process error strategy (e.g. retryThenIgnore, terminate)",
                    "fa_icon": "fas fa-exclamation-triangle"
                }
            }
        },
        "vcf_preparation": {
            "title": "VCF preparation",
            "type": "object",
            "fa_icon": "fas fa-file-medical-alt",
            "description": "Parameters controlling VCF filtering and sample-name normalisation.",
            "properties": {
                "bcftools_view_1_options": {
                    "type": "string",
                    "default": "--output-type z --write-index=tbi",
                    "description": "bcftools view options for initial sample-subsetting step",
                    "fa_icon": "fas fa-gear"
                },
                "bcftools_replace_sample_names_sed_arg": {
                    "type": "string",
                    "default": "s/_/-/g",
                    "description": "sed expression for sample-name normalisation",
                    "fa_icon": "fas fa-gear"
                },
                "filter_and_enhance_vcf_qual_min": {
                    "type": "string",
                    "default": "25",
                    "description": "Minimum QUAL score",
                    "fa_icon": "fas fa-gear"
                },
                "filter_and_enhance_vcf_avg_gq_min": {
                    "type": "string",
                    "default": "25",
                    "description": "Minimum average GQ across samples",
                    "fa_icon": "fas fa-gear"
                },
                "filter_and_enhance_vcf_avg_dp_min": {
                    "type": "string",
                    "default": "25",
                    "description": "Minimum average DP across samples",
                    "fa_icon": "fas fa-gear"
                },
                "filter_and_enhance_vcf_avg_dp_max": {
                    "type": "string",
                    "default": "200",
                    "description": "Maximum average DP across samples",
                    "fa_icon": "fas fa-gear"
                },
                "filter_and_enhance_vcf_sample_gq_min": {
                    "type": "string",
                    "default": "20",
                    "description": "Minimum per-sample GQ (set GT to missing below threshold)",
                    "fa_icon": "fas fa-gear"
                },
                "filter_and_enhance_vcf_sample_dp_min": {
                    "type": "string",
                    "default": "20",
                    "description": "Minimum per-sample DP",
                    "fa_icon": "fas fa-gear"
                },
                "filter_and_enhance_vcf_sample_dp_max": {
                    "type": "string",
                    "default": "250",
                    "description": "Maximum per-sample DP",
                    "fa_icon": "fas fa-gear"
                }
            }
        },
        "plink2_options": {
            "title": "PLINK2 options",
            "type": "object",
            "fa_icon": "fas fa-sliders-h",
            "description": "Options for PLINK2 pgen-import and PCA subworkflow steps.",
            "properties": {
                "plink2_makepgen_1_options": {
                    "type": "string",
                    "default": "--double-id --vcf-half-call missing --split-par b38 --1",
                    "description": "Options for initial VCF to pgen import",
                    "fa_icon": "fas fa-pen-to-square"
                },
                "plink2_makepgen_1_vcf_input_options": {
                    "type": "string",
                    "default": "",
                    "description": "Additional VCF input options for pgen import step 1",
                    "fa_icon": "fas fa-pen-to-square"
                },
                "plink2_makepgen_2_options": {
                    "type": "string",
                    "default": "--impute-sex max-female-xf=0.2 min-male-xf=0.8",
                    "description": "Options for sex imputation step",
                    "fa_icon": "fas fa-pen-to-square"
                },
                "plink2_makepgen_3_options": {
                    "type": "string",
                    "default": "--geno 0.1 --hwe 1e-13 0.001 --mac 70 --maf 0.01",
                    "description": "Options for common-variant QC filtering",
                    "fa_icon": "fas fa-pen-to-square"
                },
                "plink2_makepgen_4_options": {
                    "type": "string",
                    "default": "--geno 0.2",
                    "description": "Options for step-4 pgen filter",
                    "fa_icon": "fas fa-pen-to-square"
                },
                "plink2_makepgen_5_options": {
                    "type": "string",
                    "default": "--mind 0.2",
                    "description": "Options for per-sample missingness filter",
                    "fa_icon": "fas fa-pen-to-square"
                },
                "plink19_makeset_options": {
                    "type": "string",
                    "default": "--allow-extra-chr",
                    "description": "Options for PLINK1.9 makeset step in PCA subworkflow",
                    "fa_icon": "fas fa-pen-to-square"
                }
            }
        },
        "generic_options": {
            "title": "Generic options",
            "type": "object",
            "fa_icon": "fas fa-file-import",
            "description": "Less common options for the pipeline, typically set in a config file.",
            "help_text": "These options are common to all nf-core pipelines and allow you to customise some of the core preferences for how the pipeline runs.\n\nTypically these options would be set in a Nextflow config file loaded for all pipeline runs, such as `~/.nextflow/config`.",
            "properties": {
                "version": {
                    "type": "boolean",
                    "description": "Display version and exit.",
                    "fa_icon": "fas fa-question-circle",
                    "hidden": true
                },
                "publish_dir_mode": {
                    "type": "string",
                    "default": "copy",
                    "description": "Method used to save pipeline results to output directory.",
                    "help_text": "The Nextflow `publishDir` option specifies which intermediate files should be saved to the output directory. This option tells the pipeline what method should be used to move these files. See [Nextflow docs](https://www.nextflow.io/docs/latest/process.html#publishdir) for details.",
                    "fa_icon": "fas fa-copy",
                    "enum": ["symlink", "rellink", "link", "copy", "copyNoFollow", "move"],
                    "hidden": true
                },
                "hild_path": {
                    "type": "string",
                    "description": "Path to file with regions of high LD.",
                    "default": "assets/hg38_hild.txt",
                    "fa_icon": "fas fa-gear",
                    "hidden": false
                },
                "bcftools_qual_filter": {
                    "type": "string",
                    "description": "Quality filter for bcftools call.",
                    "default": "QUAL>=25",
                    "fa_icon": "fas fa-gear",
                    "hidden": false
                },
                "bcftools_info_filter": {
                    "type": "string",
                    "description": "INFO field filter for bcftools call.",
                    "default": "INFO/DP>=10 && INFO/DP<=100",
                    "fa_icon": "fas fa-gear",
                    "hidden": false
                },
                "bcftools_fmt_filter": {
                    "type": "string",
                    "description": "FORMAT field filter for bcftools call.",
                    "default": "FMT/DP>=10 && FMT/DP<=100",
                    "fa_icon": "fas fa-gear",
                    "hidden": false
                },
                "bcftools_info_filter_ensure_field_present": {
                    "type": "string",
                    "description": "Ensures specified INFO field is present for bcftools call.",
                    "default": "DP",
                    "fa_icon": "fas fa-gear",
                    "hidden": false
                },
                "bcftools_fmt_filter_ensure_field_present": {
                    "type": "string",
                    "description": "Ensures specified FORMAT field is present for bcftools call.",
                    "default": "DP",
                    "fa_icon": "fas fa-gear",
                    "hidden": false
                },
                "bcftools_filter_1_options": {
                    "type": "string",
                    "description": "Options for bcftools filter 1: filters out low quality variants.",
                    "default": "--exclude 'QUAL<25 || AVG(FORMAT/GQ)<25 || AVG(FORMAT/DP)<25 || AVG(FORMAT/DP)>200' --output-type z --write-index=tbi",
                    "fa_icon": "fas fa-gear",
                    "hidden": false
                },
                "bcftools_filter_2_options": {
                    "type": "string",
                    "description": "Options for bcftools filter 2: set low quality genotypes to missing.",
                    "default": "--exclude 'FORMAT/GQ<20 | FORMAT/DP < 20 | FORMAT/DP > 250' --set-GTs '.' --output-type z --write-index=tbi",
                    "fa_icon": "fas fa-gear",
                    "hidden": false
                },
                "bcftools_tag2tag_tag_from": {
                    "type": "string",
                    "description": "Tag from for bcftools tag2tag plugin.",
                    "default": "PL",
                    "fa_icon": "fas fa-gear",
                    "hidden": false
                },
                "bcftools_tag2tag_tag_to": {
                    "type": "string",
                    "description": "Tag to for bcftools tag2tag plugin.",
                    "default": "GP",
                    "fa_icon": "fas fa-gear",
                    "hidden": false
                },
                "inbreeding_outliers_range_stds": {
                    "type": "number",
                    "description": "Number of standard deviations for detecting inbreeding outliers.",
                    "default": 6,
                    "fa_icon": "fas fa-gear",
                    "hidden": false
                },
                "plink2_indep_pairwise_options": {
                    "type": "string",
                    "description": "Options for PLINK2 independent pairwise pruning.",
                    "default": "--mind 0.1",
                    "fa_icon": "fas fa-gear",
                    "hidden": false
                },
                "plink2_indep_pairwise_window": {
                    "type": "string",
                    "description": "Window settings for PLINK2 independent pairwise pruning.",
                    "default": "50 5 0.2",
                    "fa_icon": "fas fa-gear",
                    "hidden": false
                },
                "plink2_indep_pairwise_window_pca": {
                    "type": "string",
                    "description": "Window settings for PLINK2 independent pairwise pruning for PCA.",
                    "default": "500 50 0.2",
                    "fa_icon": "fas fa-gear",
                    "hidden": false
                },
                "plink2_king_cutoff_options": {
                    "type": "string",
                    "description": "Options for PLINK2 KING relatedness cutoff.",
                    "fa_icon": "fas fa-gear",
                    "hidden": false
                },
                "plink2_king_cutoff_threshold_pca": {
                    "type": "number",
                    "description": "Threshold for PLINK2 KING relatedness cutoff for PCA.",
                    "default": 0.0884,
                    "fa_icon": "fas fa-gear",
                    "hidden": false
                },
                "plink2_pca_settings": {
                    "type": "string",
                    "description": "Settings for PLINK2 PCA computation.",
                    "default": "allele-wts 10",
                    "fa_icon": "fas fa-gear",
                    "hidden": false
                },
                "plink2_pca_options": {
                    "type": "string",
                    "description": "Options for PLINK2 PCA computation.",
                    "default": "--freq counts",
                    "fa_icon": "fas fa-gear",
                    "hidden": false
                },
                "plink2_projection_score_settings": {
                    "type": "string",
                    "description": "Settings for PLINK2 projection score computation.",
                    "default": "2 6 header-read no-mean-imputation variance-standardize",
                    "fa_icon": "fas fa-gear",
                    "hidden": false
                },
                "plink2_projection_score_options": {
                    "type": "string",
                    "description": "Options for PLINK2 projection score computation.",
                    "default": "--score-col-nums 7-16",
                    "fa_icon": "fas fa-gear",
                    "hidden": false
                },
                "plink2_export_other_options": {
                    "type": "string",
                    "description": "Options for PLINK2 generic export.",
                    "default": "",
                    "fa_icon": "fas fa-gear",
                    "hidden": false
                },
                "plink2_import_dosage_options": {
                    "type": "string",
                    "description": "Options for PLINK2 import dosage.",
                    "default": "",
                    "fa_icon": "fas fa-gear",
                    "hidden": false
                },
                "rscript_build_phenotypes_options": {
                    "type": "string",
                    "description": "Options for R script to build phenotypes.",
                    "fa_icon": "fas fa-gear",
                    "hidden": false
                },
                "rscript_build_phenotypes_path": {
                    "type": "string",
                    "description": "Path to R script for building phenotypes.",
                    "default": "modules/local/rscript/build_phenotypes/assets/build_phenotypes.R",
                    "fa_icon": "fas fa-gear",
                    "hidden": false
                },
                "bcftools_view_options_2": {
                    "type": "string",
                    "description": "Options to pass to the second bcftools view call.",
                    "fa_icon": "fas fa-bed",
                    "hidden": false
                },
                "plink19_makebed_options": {
                    "type": "string",
                    "description": "Options to pass to plink1.9 makebed call.",
                    "default": "--double-id --vcf-half-call missing --chr 1-22,X",
                    "fa_icon": "fas fa-bed",
                    "hidden": false
                },
                "plink2_makebed_options_1": {
                    "type": "string",
                    "description": "Options to pass to plink2 makebed call 1.",
                    "fa_icon": "fas fa-pen-to-square",
                    "hidden": false
                },
                "plink2_makebed_options_2": {
                    "type": "string",
                    "description": "Options to pass to plink2 makebed call 2.",
                    "fa_icon": "fas fa-pen-to-square",
                    "hidden": false
                },
                "plink2_makebed_options_3": {
                    "type": "string",
                    "description": "Options to pass to plink2 makebed call 3.",
                    "fa_icon": "fas fa-pen-to-square",
                    "hidden": false
                },
                "plink2_makebed_options_4": {
                    "type": "string",
                    "description": "Options to pass to plink2 makebed call 4.",
                    "fa_icon": "fas fa-pen-to-square",
                    "hidden": false
                },
                "plink2_write_snplist_qc_options": {
                    "type": "string",
                    "description": "Options to pass to plink2 write-snplist qc call.",
                    "default": "--maf 0.01 --mac 100 --geno 0.1 --hwe 1e-15 --mind 0.1 --write-samples",
                    "fa_icon": "fas fa-pen-to-square",
                    "hidden": false
                },
                "plink2_write_snplist_step2_options": {
                    "type": "string",
                    "description": "Options to pass to plink2 write-snplist call for Regenie step 2.",
                    "default": "--mind 0.2",
                    "fa_icon": "fas fa-pen-to-square",
                    "hidden": false
                },
                "plink2_export_bgen_options": {
                    "type": "string",
                    "description": "Options to pass to plink2 export bgen call.",
                    "default": "--1 --export bgen-1.2 bits=8 id-paste=iid ref-first",
                    "fa_icon": "fas fa-pen-to-square",
                    "hidden": false
                },
                "plink2_makepgen_options": {
                    "type": "string",
                    "description": "Options to pass to plink2 makepgen call.",
                    "default": "--mind 0.2 --1 --make-pgen",
                    "fa_icon": "fas fa-pen-to-square",
                    "hidden": false
                },
                "plink2_missing_per_pheno_options": {
                    "type": "string",
                    "description": "Options to pass to plink2 missing per phenotype call.",
                    "fa_icon": "fas fa-pen-to-square",
                    "hidden": false
                },
                "qctool_options": {
                    "type": "string",
                    "description": "Options to pass to qctool call.",
                    "default": "-ofiletype bgen -bgen-bits 8 -bgen-compression zstd -bgen-omit-sample-identifier-block",
                    "fa_icon": "fas fa-stars",
                    "hidden": false
                },
                "bgenix_options": {
                    "type": "string",
                    "description": "Options to pass to bgenix call.",
                    "default": "-clobber",
                    "fa_icon": "fas fa-book",
                    "hidden": false
                },
                "rscript_annotate_options": {
                    "type": "string",
                    "description": "Options for annotate.R script.",
                    "default": "--min_top_annotations 50 --quantile_threshold 0.25 --include-intergenic FALSE",
                    "fa_icon": "fas fa-code",
                    "hidden": false
                },
                "rscript_annotate_path": {
                    "type": "string",
                    "description": "Path to annotate.R script.",
                    "default": "${projectDir}/modules/local/rscript/assign_annotations/assets/annotate.R",
                    "fa_icon": "fas fa-code",
                    "hidden": false
                },
                "rscript_vcf2aaf_path": {
                    "type": "string",
                    "description": "Path to vcf2aaf.R script.",
                    "default": "${projectDir}/modules/local/rscript/vcf2aaf/assets/vcf2aaf.R",
                    "fa_icon": "fas fa-code",
                    "hidden": false
                },
                "rscript_vcf2aaf_options": {
                    "type": "string",
                    "description": "Options for vcf2aaf.R script.",
                    "default": "AF_nfe_gnomad AF",
                    "fa_icon": "fas fa-gear",
                    "hidden": false
                },
                "regenie_step1_options": {
                    "type": "string",
                    "description": "Options for regenie step1.",
                    "default": "--bt --bsize 100 --lowmem",
                    "fa_icon": "fas fa-dna",
                    "hidden": false
                },
                "regenie_step2_options": {
                    "type": "string",
                    "description": "Options for regenie step2.",
                    "default": "--bt --ref-first --firth --approx --bsize 200 --lowmem --aaf-bins 0.01,0.05,0.1,1 --write-mask --write-mask-snplist --vc-tests skato",
                    "fa_icon": "fas fa-dna",
                    "hidden": false
                },
                "rscript_buildreports_path": {
                    "type": "string",
                    "description": "Path to build_reports.R script.",
                    "default": "${projectDir}/modules/local/rscript/buildreports/assets/build_reports.R",
                    "fa_icon": "fas fa-code",
                    "hidden": false
                },
                "ref_fasta_url": {
                    "type": "string",
                    "description": "Reference genome fasta file for download.",
                    "default": "https://ftp.ensembl.org/pub/release-113/fasta/homo_sapiens/dna/Homo_sapiens.GRCh38.dna.toplevel.fa.gz",
                    "fa_icon": "fas fa-pen-line",
                    "hidden": false
                },
                "vep_cache_url": {
                    "type": "string",
                    "description": "VEP cache for download.",
                    "default": "https://ftp.ensembl.org/pub/release-113/variation/indexed_vep_cache/homo_sapiens_refseq_vep_113_GRCh38.tar.gz",
                    "fa_icon": "fas fa-pen-line",
                    "hidden": false
                },
                "vep_updatecache_options": {
                    "type": "string",
                    "description": "Options for VEP update cache.",
                    "default": "--AUTO cf --ASSEMBLY GRCh38",
                    "fa_icon": "fas fa-pen-line",
                    "hidden": false
                },
                "vep_updatecache_species": {
                    "type": "string",
                    "description": "Species option for VEP update cache.",
                    "default": "homo_sapiens",
                    "fa_icon": "fas fa-pen-line",
                    "hidden": false
                },
                "vep_annotate_options": {
                    "type": "string",
                    "description": "Options for VEP annotation.",
                    "default": "--offline --no_stats --refseq --use_given_ref --exclude_predicted --compress_output bgzip --vcf --numbers --protein --total_length --force_overwrite --format vcf --regulatory --variant_class --symbol --biotype --distance 5000 --canonical --pubmed --mane",
                    "fa_icon": "fas fa-pen-line",
                    "hidden": false
                },
                "vep_annotate_species": {
                    "type": "string",
