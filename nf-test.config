config {

    testsDir "."
    workDir ".nf-test"
    configFile "tests/nextflow.config"
    profile "podman,low_resources"

    // prepare__to_delete/ holds the retired IT-1/IT-1b subworkflow tests. They assert
    // NORM/ANNOTATE/VEP behavior that moved to ../nf-prepare-vcf (Phase 3, PB2) and would
    // fail against the now-thin PREPARE body. Kept on disk only so their assertions/fixtures
    // can be migrated upstream (Phase 3, PB5), then the dir is deleted. Excluded from runs.
    ignore "subworkflows/local/prepare__to_delete/**"

}
