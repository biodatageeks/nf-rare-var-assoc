// Params for IT-1b (skip_prep_skip_reporting.nf.test).
//
// Filter thresholds are tuned to the prepared_chr12_100 fixture so that EACH
// threshold actually does something in the test:
//
// Variant-dropping filters (combined as an OR in BCFTOOLS_VIEW_AND_FILTER2,
// stats computed from the 100 fixture variants):
//   qual_min       = 300  -> QUAL min ~87,  5th ~219, 10th ~305  : drops ~9
//   avg_gq_min     = 70   -> AVG_GQ min 8.7, 5th 74, median 92   : drops ~5
//   avg_dp_min     = 31   -> AVG_DP min 29.5, 5th 30.5, 10th 31.5: drops ~5
//   avg_dp_max     = 40   -> AVG_DP max 41,  90th ~38            : drops ~1-2
//
// Sample-level filters (--set-GTs '.', do not drop variants but set bad GTs
// to missing; stats computed from per-sample FORMAT fields):
//   sample_gq_min  = 30   -> FORMAT/GQ 5th=60, 1%=0     : flags lowest ~2%
//   sample_dp_min  = 22   -> FORMAT/DP min=10, 1%=21    : flags lowest ~1-2%
//   sample_dp_max  = 45   -> FORMAT/DP max=97, 99%=47   : flags highest ~2%

params {
    filter_and_enhance_vcf_qual_min       = "300"
    filter_and_enhance_vcf_avg_gq_min     = "70"
    filter_and_enhance_vcf_avg_dp_min     = "31"
    filter_and_enhance_vcf_avg_dp_max     = "40"
    filter_and_enhance_vcf_sample_gq_min  = "30"
    filter_and_enhance_vcf_sample_dp_min  = "22"
    filter_and_enhance_vcf_sample_dp_max  = "45"
}

process {
    withName: 'BCFTOOLS_VIEW_AND_FILTER2' {
        ext.args = '--output-type z --write-index=tbi'
    }
}
