nextflow_workflow {

    name "Test Subworkflow PREPARE -- skip_preparation + skip_reporting branch"
    script "../main.nf"
    workflow "PREPARE"

    tag "ci"
    tag "subworkflows"
    tag "subworkflows/prepare"

    // IT-1b: exercises the BCFTOOLS_VIEW_AND_FILTER2 code path used by
    // nextflow-gene-assoc-tuner (see subworkflows/local/prepare/main.nf line 38).
    // skip_preparation=true && skip_reporting=true bypasses NORM/ANNOTATE/VEP
    // and routes through a single fused VIEW+FILTER+FILTER step. The input on
    // this branch must already be a prepared VCF (normalized, biallelic,
    // unique IDs, VEP-annotated) because no preparation steps run here.
    //
    // Fixtures:
    //   assets/medium_data/prepared_chr12_100.vcf.gz - 100 prepared variants
    //     on chr12, 3202 samples. Same 1000G sample IDs as cases/controls.
    //   subworkflows/local/prepare/tests/fixtures/all_samples.txt - cases
    //     (1202) concatenated with controls (2000); mirrors the all.samples
    //     file JOIN_CASES_AND_CONTROLS produces in production.
    //
    // Filter params: see skip_prep_skip_reporting.config. The seven thresholds
    // are tuned against the fixture so that EACH filter is active --
    // collectively the variant-level filters drop exactly 18 of 100 variants
    // (82 survive); the sample-level filters with --set-GTs '.' replace bad
    // genotypes with missing across all surviving variants.
    //
    // Expected output (computed from fixture + thresholds with a bcftools
    // pipeline mirroring the module; numbers are exact and deterministic):
    //   variant count   = 82
    //   sample count    = 3202 (sample preservation)
    //   missing GT cnt  ~= 6510 (input has only 13 -> sample-level filter ran)
    //   "12_3038037_C_T" (QUAL ~80148, highest)  -> PRESENT in output
    //   "12_548082_A_G"  (QUAL ~86.69, lowest)   -> ABSENT (failed qual_min=300)
    //   tracking JSON    -> inputs.variants=100, outputs.variants=82,
    //                       inputs.samples=outputs.samples=3202

    config "./skip_prep_skip_reporting.config"

    test("skip_preparation + skip_reporting branch - VIEW_AND_FILTER2 preserves all 3202 samples, drops 18 of 100 variants, and sets sub-threshold genotypes to missing") {

        when {
            params {
                skip_preparation = true
                skip_reporting   = true
                use_dosage       = true
            }
            workflow {
                """
                input[0] = Channel.of(
                    tuple(
                        [ id:'test' ],
                        file('${projectDir}/assets/medium_data/prepared_chr12_100.vcf.gz', checkIfExists: true)
                    )
                )
                // ch_vep_cachesubdir is not consumed on this branch (no NORM/VEP).
                // Pass an existing path purely to satisfy the channel shape; the
                // value never reaches a process.
                input[1] = Channel.value(file('${projectDir}/assets/empty_tracking.json', checkIfExists: true))
                input[2] = Channel.of(
                    tuple(
                        [ id:'test' ],
                        file('${projectDir}/subworkflows/local/prepare/tests/fixtures/all_samples.txt', checkIfExists: true)
                    )
                )
                """
            }
        }

        then {
            assert workflow.success

            // ---- VCF body assertions (read the output VCF once, derive all checks) ----
            def vcf_path = workflow.out.prepared_vcf[0][1]
            def vcf_lines = ["bash", "-c", "zcat ${vcf_path}"].execute().text.split('\n') as List

            // Sample-preservation invariant: VIEW_AND_FILTER2 must keep all 3202
            // samples (the #CHROM header line's columns 10+ are sample names).
            def header_line = vcf_lines.find { it.startsWith('#CHROM') }
            assert header_line != null : "output VCF must have a #CHROM header line"
            def sample_cols = header_line.split('\t').drop(9)
            assert sample_cols.size() == 3202 :
                "output VCF must retain all 3202 input samples (got ${sample_cols.size()})"
            // Spot-check one specific 1000G ID is present (catches a bug where
            // REPLACE_SAMPLE_NAMES corrupts IDs or sample order is shuffled).
            assert 'HG00096' in sample_cols :
                "expected sample HG00096 to be preserved in output header"

            // Exact variant-count invariant. The four variant-level thresholds
            // (qual_min=300, avg_gq_min=70, avg_dp_min=31, avg_dp_max=40) form a
            // disjunctive --exclude expression that drops exactly 18 of 100
            // input variants on this fixture, confirmed by replaying the same
            // bcftools pipeline by hand. A change to either the fixture or the
            // module's filter expression will surface as a count mismatch here.
            def data_lines = vcf_lines.findAll { it && !it.startsWith('#') }
            assert data_lines.size() == 82 :
                "expected exactly 82 surviving variants (input=100, 18 dropped by variant-level filters), got ${data_lines.size()}"

            // Identity-level filter wiring: the highest-QUAL variant must pass
            // ALL filters (proves the filter is not inverted or stuck-on); the
            // lowest-QUAL variant must be dropped (proves qual_min wires through
            // to the bcftools --exclude expression).
            def variant_ids = data_lines.collect { it.split('\t')[2] }
            assert '12_3038037_C_T' in variant_ids :
                "highest-QUAL variant 12_3038037_C_T (QUAL=80148) must survive all filters"
            assert !('12_548082_A_G' in variant_ids) :
                "lowest-QUAL variant 12_548082_A_G (QUAL=86.69) must be dropped by qual_min=300"

            // Sample-level filter invariant: with sample_gq_min=30, sample_dp_min=22,
            // sample_dp_max=45 and --set-GTs '.', bad genotypes are rewritten to
            // missing. The input VCF carries only 13 './.' calls across all 100
            // variants; the output (over 82 surviving variants) should carry
            // ~6510. A floor of 1000 is well above any plausible baseline and
            // would only be hit if the second bcftools filter ran with --set-GTs.
            def missing_gt_count = 0
            data_lines.each { line ->
                def fields = line.split('\t')
                def gt_idx = fields[8].split(':').findIndexOf { it == 'GT' }
                fields.drop(9).each { sample_field ->
                    def gt = sample_field.split(':')[gt_idx]
                    if (gt == './.' || gt == '.|.') missing_gt_count++
                }
            }
            assert missing_gt_count > 1000 :
                "expected >1000 missing genotypes after sample-level --set-GTs '.' filter (input had only 13), got ${missing_gt_count}"

            // ---- prepared_vcf_tbi emit wiring ----
            // BCFTOOLS_VIEW_AND_FILTER2 runs with --write-index=tbi (see
            // skip_prep_skip_reporting.config); the .tbi file must be carried
            // through the subworkflow emit so downstream consumers can use it.
            def tbi_path = workflow.out.prepared_vcf_tbi[0][1]
            assert tbi_path.toString().endsWith('.tbi') :
                "prepared_vcf_tbi emit must carry a .tbi file, got ${tbi_path}"

            // ---- Tracking-JSON cross-checks against the VCF body ----
            // The module computes counts via `bcftools stats`; cross-checking
            // them against our header/body counts catches a bug where the
            // module reads stats from the wrong file.
            def tracking_path = workflow.out.tracking[0]
            def tracking = new groovy.json.JsonSlurper().parseText(file(tracking_path).text)
            assert tracking.process_name.contains('BCFTOOLS_VIEW_AND_FILTER2') :
                "tracking process_name should reference BCFTOOLS_VIEW_AND_FILTER2, got '${tracking.process_name}'"
            assert (tracking.inputs.variants as int) == 100 :
                "tracking.inputs.variants should be 100, got ${tracking.inputs.variants}"
            assert (tracking.outputs.variants as int) == 82 :
                "tracking.outputs.variants should be 82 (matches VCF body count), got ${tracking.outputs.variants}"
            assert (tracking.inputs.samples as int) == 3202 :
                "tracking.inputs.samples should be 3202, got ${tracking.inputs.samples}"
            assert (tracking.outputs.samples as int) == 3202 :
                "tracking.outputs.samples should be 3202 (matches VCF header sample count), got ${tracking.outputs.samples}"
        }
    }

}
