// TODO nf-core: Once you have added the required tests, please run the following command to build this file:
// nf-core modules test mergeresults
nextflow_process {

    name "Test Process MERGE_RESULTS"
    script "../main.nf"
    process "MERGE_RESULTS"

    tag "modules"
    tag "modules_"
    tag "mergeresults"

    test("merging 4 regenie files") {
        when {
            process {
                """
                input[0] = file('${projectDir}/modules/local/merge_results/assets/csv_concat.py', checkIfExists: true)

                f1 = file('${projectDir}/modules/local/merge_results/tests/assets/chr1_Y1.regenie.gz')
                f2 = file('${projectDir}/modules/local/merge_results/tests/assets/chr2_Y1.regenie.gz')
                f3 = file('${projectDir}/modules/local/merge_results/tests/assets/chr1_Y2.regenie.gz')
                f4 = file('${projectDir}/modules/local/merge_results/tests/assets/chr2_Y2.regenie.gz')

                regenie_step2_out = Channel.of( ['chr1', f1], ['chr2', f2], ['chr1', f3], ['chr2', f4])
                input[1] = regenie_step2_out
                  .transpose()
                  .map { prefix, file -> tuple(file.baseName.replaceAll(prefix + "_", '').replaceAll('.regenie', ''), file) }.groupTuple().view()
                """
            }
        }

        then {
            assert process.success
            with(process.out) {

                with(results_merged){
                    assert size() == 2

                    def lines = path(get(0).get(1)).readLinesGzip()

                    assert lines.get(0).equals("CHROM\tGENPOS\tID\tALLELE0\tALLELE1\tA1FREQ\tINFO\tN\tTEST\tBETA\tSE\tCHISQ\tLOG10P\tEXTRA")


                    //check amount of lines of Y1
                    assert (lines.size() == 502)

                    lines = path(get(1).get(1)).readLinesGzip()

                    assert lines.get(0).equals("CHROM\tGENPOS\tID\tALLELE0\tALLELE1\tA1FREQ\tINFO\tN\tTEST\tBETA\tSE\tCHISQ\tLOG10P\tEXTRA")

                    //check amount of lines of Y2
                    assert (lines.size() == 501)

                }
            }

        }

    }

    test("merging fileA and fileB") {
        when {
            process {
                """
                input[0] = file('${projectDir}/modules/local/merge_results/assets/csv_concat.py', checkIfExists: true)

                f1 = file('${projectDir}/modules/local/merge_results/tests/assets/chr1_A.csv')
                f2 = file('${projectDir}/modules/local/merge_results/tests/assets/chr2_A.csv')

                input[1] = Channel.of( ['chr1', f1], ['chr2', f2])
                  .transpose()
                  .map { prefix, file -> tuple(file.baseName.replaceAll(prefix + "_", ''), file) }.groupTuple()
                """
            }
        }

        then {
            assert process.success
            with(process.out) {

                with(results_merged){
                    assert size() == 1

                    def lines = path(get(0).get(1)).readLinesGzip()

                    assert lines.get(0).equals("A\tB\tC")
                    assert lines.get(1).equals("1\t2\t3")
                    assert lines.get(2).equals("4\t5\t6")
                    assert lines.get(3).equals("7\t8\t9")
                    assert lines.get(4).equals("10\t11\t12")

                    assert (lines.size() == 5)

                }
            }

        }

    }

}
