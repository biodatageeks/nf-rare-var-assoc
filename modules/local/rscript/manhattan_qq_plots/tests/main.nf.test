// TODO nf-core: Once you have added the required tests, please run the following command to build this file:
// nf-core modules test rscriptmanhattanqqplots
nextflow_process {

    name "Test Process RSCRIPT_MANHATTAN_QQ_PLOTS"
    script "../main.nf"
    process "RSCRIPT_MANHATTAN_QQ_PLOTS"

    tag "modules"
    tag "modules_"
    tag "rscriptmanhattanqqplots"

    // TODO nf-core: Change the test name preferably indicating the test-data and file-format used
    test("generate html report with plots") {

        // TODO nf-core: If you are created a test for a chained module
        // (the module requires running more than one process to generate the required output)
        // add the 'setup' method here.
        // You can find more information about how to use a 'setup' method in the docs (https://nf-co.re/docs/contributing/modules#steps-for-creating-nf-test-for-chained-modules).

        when {
            process {
                """
                input[0] = [
                    'Y1', // phenotype
                    file('${projectDir}/modules/local/merge_results/tests/assets/chr1_Y1.regenie.gz', checkIfExists: true)
                ]
                input[1] = file("${projectDir}/modules/local/rscript/manhattan_qq_plots/assets/gene_level_report_template.Rmd", checkIfExists: true)
                input[2] = file("${projectDir}/modules/local/rscript/manhattan_qq_plots/assets/functions.R", checkIfExists: true)
                input[3] = file('${projectDir}/modules/local/rscript/manhattan_qq_plots/tests/assets/masks.txt', checkIfExists: true)
                input[4] = [
                    [ id:'test', single_end:false ], // meta map
                    file('${projectDir}/modules/local/rscript/manhattan_qq_plots/tests/assets/phenotype.txt', checkIfExists: true)
                ]
                input[5] = file("${projectDir}/modules/local/rscript/manhattan_qq_plots/assets/child_phenostatistics.Rmd", checkIfExists: true)
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                // { assert snapshot(process.out).match() }
                //TODO nf-core: Add all required assertions to verify the test output.
                // See https://nf-co.re/docs/contributing/tutorials/nf-test_assertions for more information and examples.
            )
        }

    }

}
