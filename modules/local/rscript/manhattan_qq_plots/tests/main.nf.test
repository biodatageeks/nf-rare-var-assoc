nextflow_process {

    name "Test Process RSCRIPT_MANHATTAN_QQ_PLOTS"
    script "../main.nf"
    process "RSCRIPT_MANHATTAN_QQ_PLOTS"

    tag "ci"
    tag "modules"
    tag "rscript/manhattan_qq_plots"

    // Smoke test per reporting carve-out (see docs/test-quality-and-cleanup-plan.md).
    // Reuses IT-5 fixtures from subworkflows/local/reporting/tests/fixtures/.
    //
    // Module signature (1 input - 11-element tuple):
    //   tuple val(meta), path(phenotype_file), path(pc_plot_file), path(eda_plots),
    //         path(setlist_file), val(phenotype), path(regenie_merged), path(mask_file),
    //         path(gwas_report_template), path(r_functions_file), path(rmd_pheno_stats_file)
    //
    // Production caller: subworkflows/local/reporting/main.nf:23
    test("IT-5 fixtures - html report emitted with expected filename") {

        when {
            params {
                project_name                 = 'test-project'
                project_date                 = '2026-05-28'
                phenotypes_apply_rint        = false
                manhattan_annotation_enabled = false
                annotation_min_log10p        = 1
                plot_ylimit                  = 0
            }
            process {
                """
                input[0] = tuple(
                    [ id:'test' ],
                    file('${projectDir}/subworkflows/local/reporting/tests/fixtures/pheno.tsv',     checkIfExists: true),
                    file('${projectDir}/subworkflows/local/reporting/tests/fixtures/pc_plot.png',   checkIfExists: true),
                    file('${projectDir}/subworkflows/local/reporting/tests/fixtures/eda_plot.png',  checkIfExists: true),
                    file('${projectDir}/subworkflows/local/reporting/tests/fixtures/test.setlist',  checkIfExists: true),
                    'Y1',
                    file('${projectDir}/subworkflows/local/reporting/tests/fixtures/Y1.regenie.gz', checkIfExists: true),
                    file('${projectDir}/subworkflows/local/reporting/tests/fixtures/masks.txt',     checkIfExists: true),
                    file('${projectDir}/modules/local/rscript/manhattan_qq_plots/assets/gene_level_report_template.Rmd', checkIfExists: true),
                    file('${projectDir}/modules/local/rscript/manhattan_qq_plots/assets/functions.R',                   checkIfExists: true),
                    file('${projectDir}/modules/local/rscript/manhattan_qq_plots/assets/child_phenostatistics.Rmd',     checkIfExists: true)
                )
                """
            }
        }

        then {
            assert process.success

            // Reporting carve-out: assert the HTML report is emitted with the expected filename.
            def html_path = process.out.plots_report[0]
            assert html_path.toString().endsWith('_manhattan_qq_plots.html') :
                "expected HTML filename ending in '_manhattan_qq_plots.html', got: ${html_path}"

            assert snapshot(process.out.versions).match()
        }

    }

}
