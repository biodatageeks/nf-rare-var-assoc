nextflow_process {

    name "Test Process RSCRIPT_BUILDREPORTS"
    script "../main.nf"
    process "RSCRIPT_BUILDREPORTS"

    tag "ci"
    tag "modules"
    tag "rscript"
    tag "rscript/buildreports"

    test("hand-rolled fixtures - matches expected annotated CSV outputs") {

        when {
            process {
                """
                input[0] = [
                    [ id:'test', single_end:false ],
                    file('${projectDir}/modules/local/rscript/buildreports/tests/fixtures/masks.snplist', checkIfExists: true),
                    file('${projectDir}/modules/local/rscript/buildreports/tests/fixtures/regenie_step2_Y1.regenie', checkIfExists: true),
                    file('${projectDir}/modules/local/rscript/buildreports/tests/fixtures/sample.vcf', checkIfExists: true),
                    file('${projectDir}/modules/local/rscript/buildreports/tests/fixtures/phenotype.tsv', checkIfExists: true),
                    file('${projectDir}/modules/local/rscript/buildreports/tests/fixtures/annotations.tsv', checkIfExists: true),
                    file('${projectDir}/modules/local/rscript/buildreports/assets/build_reports.R', checkIfExists: true)
                ]
                """
            }
        }

        then {
            assert process.success

            // Compare the three output CSVs to expected fixtures byte-for-byte.
            // See fixtures/expected/README.md for the case/control AF derivation that
            // motivates each expected row.
            def expected_dir = "${projectDir}/modules/local/rscript/buildreports/tests/fixtures/expected"
            assert path(process.out.annotated_snps[0][1]).text == path("${expected_dir}/annotated_snps.csv").text
            assert path(process.out.res_log10p_1_annotated[0][1]).text == path("${expected_dir}/res_log10p_1_annotated.csv").text
            assert path(process.out.annotated_snps_with_sample_ids[0][1]).text == path("${expected_dir}/annotated_snps_with_sample_ids.csv").text

            assert snapshot(process.out.versions).match()
        }

    }

}
