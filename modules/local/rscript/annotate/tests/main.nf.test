// TODO nf-core: Once you have added the required tests, please run the following command to build this file:
// nf-core modules test rscriptannotate
nextflow_process {

    name "Test Process RSCRIPT_ANNOTATE"
    script "../main.nf"
    process "RSCRIPT_ANNOTATE"

    tag "modules"
    tag "modules_"
    tag "rscriptannotate"

    // TODO nf-core: Change the test name preferably indicating the test-data and file-format used
    test("small vcf") {

        // TODO nf-core: If you are created a test for a chained module
        // (the module requires running more than one process to generate the required output)
        // add the 'setup' method here.
        // You can find more information about how to use a 'setup' method in the docs (https://nf-co.re/docs/contributing/modules#steps-for-creating-nf-test-for-chained-modules).

        setup {
            run("PLINK2_MAKEBED") {
                script "../../../plink2/makebed/main.nf"
                process {
                    """
                    input[0] = [
                        [ id:'test', single_end:false ], // meta map
                        [],  // bed
                        [],  // bim
                        [],  // fam
                        file('${projectDir}/assets/medium_data/1kGP.chr22.panel_head100k_exome_vep.vcf', checkIfExists: true),
                        []   // frq
                    ]
                    input[1] = 'filter'
                    input[2] = '--mac 1 --double-id --vcf-half-call missing'
                    """
                }
            }
            run("PLINK2_EXPORT_BGEN") {
                script "../../../plink2/export_bgen/main.nf"
                process {
                    """
                    input[0] = PLINK2_MAKEBED.out.out_bed_bim_fam
                    input[1] = 'pvcf.norm_zlib'
                    input[2] = '--1 --export bgen-1.2 bits=8 id-paste=iid ref-first'
                    """
                }
            }
            run("BGENIX") {
                script "../../../bgenix/main.nf"
                process {
                    """
                    input[0] = PLINK2_EXPORT_BGEN.out.bgen
                    input[1] = '-clobber'
                    """
                }
            }
        }

        when {
            process {
                """
                input[0] = file('${projectDir}/modules/local/rscript/annotate/assets/annotate.R', checkIfExists: true)
                input[1] = [
                    [ id:'test', single_end:false ], // meta map
                    file('${projectDir}/assets/medium_data/1kGP.chr22.panel_head100k_exome_vep.vcf', checkIfExists: true)
                ]
                input[2] = PLINK2_MAKEBED.out.out_bed_bim_fam
                input[3] = PLINK2_EXPORT_BGEN.out.bgen
                input[4] = BGENIX.out.bgen_bgi
                input[5] = PLINK2_EXPORT_BGEN.out.sample
                input[6] = [
                    [ id:'test', single_end:false ], // meta map
                    file('${projectDir}/assets/medium_data/1kGP_controls.txt', checkIfExists: true)
                ]
                input[7] = [
                    [ id:'test', single_end:false ], // meta map
                    file('${projectDir}/assets/medium_data/1kGP_cases.txt', checkIfExists: true)
                ]
                input[8] = file('${projectDir}/assets/default.masks', checkIfExists: true)
                input[9] = '--min_top_annotations 50 --quantile_threshold 0.25 --include-intergenic FALSE'
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
                //TODO nf-core: Add all required assertions to verify the test output.
                // See https://nf-co.re/docs/contributing/tutorials/nf-test_assertions for more information and examples.
            )
        }

    }

    test("minimal dataset") {
        setup {
            // Run the required setup processes
            run("PLINK2_MAKEBED") {
                script "../../../plink2/makebed/main.nf"
                process {
                    """
                    input[0] = [
                        [ id:'test', single_end:false ], // meta map
                        [],  // bed
                        [],  // bim
                        [],  // fam
                        file('${projectDir}/assets/small_data/minimal.vcf', checkIfExists: true),
                        []   // frq
                    ]
                    input[1] = 'filter'
                    input[2] = '--mac 1 --double-id --vcf-half-call missing'
                    """
                }
            }

            run("PLINK2_EXPORT_BGEN") {
                script "../../../plink2/export_bgen/main.nf"
                process {
                    """
                    input[0] = PLINK2_MAKEBED.out.out_bed_bim_fam
                    input[1] = 'pvcf.norm_zlib'
                    input[2] = '--1 --export bgen-1.2 bits=8 id-paste=iid ref-first'
                    """
                }
            }

            run("BGENIX") {
                script "../../../bgenix/main.nf"
                process {
                    """
                    input[0] = PLINK2_EXPORT_BGEN.out.bgen
                    input[1] = '-clobber'
                    """
                }
            }
        }

        when {
            process {
                """
                input[0] = file('${projectDir}/modules/local/rscript/annotate/assets/annotate.R')
                input[1] = [ [ id:'test' ], file('${projectDir}/assets/small_data/minimal.vcf', checkIfExists: true) ]
                input[2] = PLINK2_MAKEBED.out.out_bed_bim_fam
                input[3] = PLINK2_EXPORT_BGEN.out.bgen
                input[4] = BGENIX.out.bgen_bgi
                input[5] = PLINK2_EXPORT_BGEN.out.sample
                input[6] = [ [ id:'test' ], file('${projectDir}/assets/small_data/minimal_controls.txt', checkIfExists: true) ]
                input[7] = [ [ id:'test' ], file('${projectDir}/assets/small_data/minimal_cases.txt', checkIfExists: true) ]
                input[8] = file('${projectDir}/assets/default.masks', checkIfExists: true)
                input[9] = '--min_top_annotations 50 --quantile_threshold 0.25 --include-intergenic TRUE'
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                {

                    def annotations = path(process.out.annotations.get(0).get(1)).readLines()
                    assert annotations[0] == "1_1000_A_G\tGENE1\tmissense_variant"
                    assert annotations[1] == "1_1001_A_G\tGENE2\tmissense_variant"
                    assert annotations[2] == "1_2000_C_T\tREG_ENSR00001234567\tregulatory_region_variant"
                    assert annotations[3] == "1_3000_G_A\tINT_1_3000_d1\tintergenic_variant"
                    assert annotations[4] == "1_3001_G_A\tINT_1_3001_d1\tintergenic_variant"
                    assert annotations[5] == "1_3002_G_A\tINT_1_3002_d1\tintergenic_variant"
                    assert annotations[6] == "1_4000_T_C\tREG_ENSR00002345678\tenhancer_variant"
                    assert annotations[7] == "1_5000_A_T\tREG_ENSR00003456789\tTF_binding_site_variant"
                    assert annotations[8] == "1_5001_A_T\tREG_ENSR00003456790\tTF_binding_site_variant"

                    def setlist = path(process.out.setlist.get(0).get(1)).readLines()
                    assert setlist[0] == "GENE1\t1\t1000\t1_1000_A_G"
                    assert setlist[1] == "GENE2\t1\t1001\t1_1001_A_G"
                    assert setlist[2] == "REG_ENSR00001234567\t1\t2000\t1_2000_C_T"
                    assert setlist[3] == "INT_1_3000_d1\t1\t3000\t1_3000_G_A"
                    assert setlist[4] == "INT_1_3001_d1\t1\t3001\t1_3001_G_A"
                    assert setlist[5] == "INT_1_3002_d1\t1\t3002\t1_3002_G_A"
                    assert setlist[6] == "REG_ENSR00002345678\t1\t4000\t1_4000_T_C"
                    assert setlist[7] == "REG_ENSR00003456789\t1\t5000\t1_5000_A_T"
                    assert setlist[8] == "REG_ENSR00003456790\t1\t5001\t1_5001_A_T"

                    def phenotype = path(process.out.phenotype.get(0).get(1)).readLines()
                    assert phenotype[0] == "FID\tIID\tY1"
                    assert phenotype[1] == "sample1\tsample1\t0"
                    assert phenotype[2] == "sample2\tsample2\t1"
                    assert phenotype[3] == "sample3\tsample3\t0"

                },
                { assert path(process.out.phenotype.get(0).get(1)).readLines().size() == 4 }
            )
        }
    }

}
