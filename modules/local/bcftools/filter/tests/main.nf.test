nextflow_process {

    name "Test Process BCFTOOLS_FILTER"
    script "../main.nf"
    process "BCFTOOLS_FILTER"

    tag "ci"
    tag "modules"
    tag "bcftools"
    tag "bcftools/filter"

    test("sarscov2 - pass-through filter preserves all variants") {

        config "./nextflow.config"

        when {
            process {
                """
                input[0] = [
                    [ id:'sample', single_end:false ],
                    file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/vcf/test.vcf.gz', checkIfExists: true),
                    file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/vcf/test.vcf.gz.tbi', checkIfExists: true),
                    [],
                    [],
                    [],
                    [],
                    []
                ]
                input[1] = '--output-type v'
                input[2] = 'filter_pass'
                """
            }
        }

        then {
            assert process.success
            assert process.out.vcf.size() == 1
            assert process.out.tracking_out.size() == 1
            assert process.out.versions.size() == 1

            def tracking = new groovy.json.JsonSlurper().parseText(file(process.out.tracking_out[0]).text)
            // No filter applied, so input and output counts must match exactly.
            assert tracking.inputs.variants == tracking.outputs.variants
            assert tracking.inputs.samples == tracking.outputs.samples
            assert tracking.inputs.variants > 0
            assert tracking.outputs.variants > 0

            // Output VCF record count must match what tracking JSON reports.
            def out_vcf_records = path(process.out.vcf[0][1]).readLines().findAll { !it.startsWith('#') && it.trim() }.size()
            assert out_vcf_records == tracking.outputs.variants
        }

    }

    test("sarscov2 - --exclude predicate actually removes variants") {

        config "./nextflow.config"

        when {
            process {
                """
                input[0] = [
                    [ id:'sample', single_end:false ],
                    file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/vcf/test.vcf.gz', checkIfExists: true),
                    file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/vcf/test.vcf.gz.tbi', checkIfExists: true),
                    [],
                    [],
                    [],
                    [],
                    []
                ]
                // Exclude every record (POS is always positive in a real VCF); proves the predicate is being applied.
                input[1] = "--exclude 'POS>0' --output-type v"
                input[2] = 'filter_strict'
                """
            }
        }

        then {
            assert process.success

            def tracking = new groovy.json.JsonSlurper().parseText(file(process.out.tracking_out[0]).text)
            assert tracking.inputs.variants > 0
            assert tracking.outputs.variants == 0
            // Sample-level data unaffected by a record-level filter.
            assert tracking.inputs.samples == tracking.outputs.samples

            def out_vcf_records = path(process.out.vcf[0][1]).readLines().findAll { !it.startsWith('#') && it.trim() }.size()
            assert out_vcf_records == 0
        }

    }

    test("sarscov2 - --write-index=tbi emits a tbi alongside the bgzipped VCF") {

        config "./nextflow.config"

        when {
            process {
                """
                input[0] = [
                    [ id:'sample', single_end:false ],
                    file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/vcf/test.vcf.gz', checkIfExists: true),
                    file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/vcf/test.vcf.gz.tbi', checkIfExists: true),
                    [],
                    [],
                    [],
                    [],
                    []
                ]
                input[1] = '--output-type z --write-index=tbi'
                input[2] = 'filter_indexed'
                """
            }
        }

        then {
            assert process.success
            assert process.out.vcf.size() == 1
            assert process.out.tbi.size() == 1
            assert process.out.csi.size() == 0
            assert process.out.vcf[0][1].endsWith('.vcf.gz')
            assert process.out.tbi[0][1].endsWith('.vcf.gz.tbi')

            def tracking = new groovy.json.JsonSlurper().parseText(file(process.out.tracking_out[0]).text)
            assert tracking.inputs.variants > 0
            // Pass-through (no --include/--exclude) keeps every record.
            assert tracking.inputs.variants == tracking.outputs.variants

            assert snapshot(process.out.versions).match()
        }

    }

}
