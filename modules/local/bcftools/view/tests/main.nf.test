nextflow_process {

    name "Test Process BCFTOOLS_VIEW"
    script "../main.nf"
    process "BCFTOOLS_VIEW"

    tag "ci"
    tag "modules"
    tag "bcftools"
    tag "bcftools/view"

    // Module signature (3 inputs):
    //   tuple val(meta), path(vcf), path(index), path(regions), path(targets),
    //         path(samples), path(snplist), path(tracking_in)
    //   val(input_args)
    //   val(out_name_part)
    // Use [] for unused path slots.
    //
    // sarscov2 test.vcf.gz: 9 records, 1 sample ('test'), all on MT192765.1.
    // Fixture files (tests/fixtures/):
    //   regions_first_5kb.bed - BED region MT192765.1:0-5000 (2 records: pos 197, 4788)
    //   samples_test.txt      - single sample name 'test'

    test("sarscov2 - regions filter: 2 of 9 variants pass (positions within MT192765.1:1-5000)") {

        config "./nextflow.config"

        when {
            process {
                """
                // BED-format regions file covers the first 5 kb of MT192765.1.
                // 2 of 9 records fall in this window (positions 197 and 4788).
                // tbi provided so bcftools can use the index for region-based filtering.
                // tracking_in = [] because we are not chaining.
                input[0] = [
                    [ id:'test' ],
                    file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/vcf/test.vcf.gz', checkIfExists: true),
                    file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/vcf/test.vcf.gz.tbi', checkIfExists: true),
                    file('${projectDir}/modules/local/bcftools/view/tests/fixtures/regions_first_5kb.bed', checkIfExists: true),
                    [],   // targets
                    [],   // samples
                    [],   // snplist
                    []    // tracking_in
                ]
                input[1] = ''
                input[2] = 'view_regions'
                """
            }
        }

        then {
            assert process.success
            assert process.out.vcf.size() == 1
            assert process.out.tracking_out.size() == 1

            def tracking = new groovy.json.JsonSlurper().parseText(file(process.out.tracking_out[0]).text)
            assert tracking.inputs.variants == 9  : "sarscov2 test VCF has 9 records"
            assert tracking.outputs.variants == 2 : "only positions 197 and 4788 fall within MT192765.1:1-5000"
            assert tracking.outputs.variants < tracking.inputs.variants : "region filter must reduce variant count"

            assert snapshot(process.out.versions).match()
        }

    }

    test("sarscov2 - samples filter: output header lists exactly the requested sample 'test'") {

        config "./nextflow.config"

        when {
            process {
                """
                // Samples file contains one sample name: 'test'.
                // The sarscov2 VCF has exactly 1 sample ('test'), so the count stays at 1.
                // Exercises the --samples-file code path and asserts the output header
                // names the expected sample.
                input[0] = [
                    [ id:'test' ],
                    file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/vcf/test.vcf.gz', checkIfExists: true),
                    file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/vcf/test.vcf.gz.tbi', checkIfExists: true),
                    [],   // regions
                    [],   // targets
                    file('${projectDir}/modules/local/bcftools/view/tests/fixtures/samples_test.txt', checkIfExists: true),
                    [],   // snplist
                    []    // tracking_in
                ]
                input[1] = ''
                input[2] = 'view_samples'
                """
            }
        }

        then {
            assert process.success
            assert process.out.vcf.size() == 1
            assert process.out.tracking_out.size() == 1

            // The #CHROM header line's columns 10+ are sample names.
            def header_line = path(process.out.vcf.get(0).get(1)).readLines().find { it.startsWith('#CHROM') }
            assert header_line != null : "output VCF must have a #CHROM header line"
            def col_samples = header_line.split('\t').drop(9)
            assert col_samples.size() == 1  : "expected exactly 1 sample in output header"
            assert col_samples[0] == 'test' : "output must retain the sample named 'test'"

            def tracking = new groovy.json.JsonSlurper().parseText(file(process.out.tracking_out[0]).text)
            assert tracking.outputs.samples == 1 : "output has 1 sample"

            assert snapshot(process.out.versions).match()
        }

    }

}
