nextflow_process {

    name "Test Process BCFTOOLS_ANNOTATE"
    script "../main.nf"
    process "BCFTOOLS_ANNOTATE"

    tag "ci"
    tag "modules"
    tag "bcftools"
    tag "bcftools/annotate"

    // Module signature (2 inputs):
    //   tuple val(meta), path(input), path(index), path(annotations), path(annotations_index),
    //         path(header_lines), path(rename_chrs)
    //   val(out_name_part)
    // Use [] for unused path slots.

    test("sarscov2 - strip INFO/DP via -x flag, vcf.gz output") {

        config "./vcf.config"

        when {
            process {
                """
                input[0] = [
                    [ id:'test', single_end:false ],
                    file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/vcf/test.vcf.gz', checkIfExists: true),
                    file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/vcf/test.vcf.gz.tbi', checkIfExists: true),
                    file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/vcf/test2.vcf.gz', checkIfExists: true),
                    file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/vcf/test2.vcf.gz.tbi', checkIfExists: true),
                    [], // header_lines - not exercised
                    []  // rename_chrs - not exercised
                ]
                input[1] = "annotated"
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                // -x INFO/DP must remove the DP depth field from the output header
                { assert !path(process.out.vcf.get(0).get(1)).LinesGzip.any { it.startsWith("##INFO=<ID=DP,") } },
                { assert snapshot(process.out.versions).match() }
            )
        }

    }

    test("sarscov2 - write-index default (csi), vcf.gz output") {

        config "./vcf_gz_index.config"

        when {
            process {
                """
                input[0] = [
                    [ id:'test', single_end:false ],
                    file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/vcf/test.vcf.gz', checkIfExists: true),
                    file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/vcf/test.vcf.gz.tbi', checkIfExists: true),
                    file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/vcf/test2.vcf.gz', checkIfExists: true),
                    file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/vcf/test2.vcf.gz.tbi', checkIfExists: true),
                    [],
                    []
                ]
                input[1] = "annotated"
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                // --write-index (default) must produce a .csi alongside the bgzipped VCF
                { assert process.out.csi[0][1].endsWith(".csi") },
                { assert snapshot(process.out.versions).match() }
            )
        }

    }

    test("sarscov2 - write-index=tbi, vcf.gz output") {

        config "./vcf_gz_index_tbi.config"

        when {
            process {
                """
                input[0] = [
                    [ id:'test', single_end:false ],
                    file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/vcf/test.vcf.gz', checkIfExists: true),
                    file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/vcf/test.vcf.gz.tbi', checkIfExists: true),
                    file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/vcf/test2.vcf.gz', checkIfExists: true),
                    file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/vcf/test2.vcf.gz.tbi', checkIfExists: true),
                    [],
                    []
                ]
                input[1] = "annotated"
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                // --write-index=tbi must produce a .tbi (not .csi) alongside the bgzipped VCF
                { assert process.out.tbi[0][1].endsWith(".tbi") },
                { assert process.out.csi.size() == 0 },
                { assert snapshot(process.out.versions).match() }
            )
        }

    }

    test("sarscov2 - inject header lines via --header-lines, vcf output") {

        // bcf.config uses --output-type v (plain VCF) so header content is directly readable
        config "./bcf.config"

        when {
            process {
                """
                input[0] = [
                    [ id:'test', single_end:false ],
                    file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/vcf/test.vcf.gz', checkIfExists: true),
                    [],
                    file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/vcf/test2.vcf.gz', checkIfExists: true),
                    file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/vcf/test2.vcf.gz.tbi', checkIfExists: true),
                    file("${projectDir}/modules/local/bcftools/annotate/tests/fixtures/headers.vcf", checkIfExists: true),
                    []  // rename_chrs - not exercised
                ]
                input[1] = "annotated"
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                // --header-lines must inject the SGB INFO field into the output header
                { assert path(process.out.vcf.get(0).get(1)).text.contains("##INFO=<ID=SGB,") },
                { assert snapshot(process.out.versions).match() }
            )
        }

    }

    test("sarscov2 - rename chromosomes via --rename-chrs, vcf.gz output") {

        config "./vcf_gz_index.config"

        when {
            process {
                """
                input[0] = [
                    [ id:'test', single_end:false ],
                    file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/vcf/test.vcf.gz', checkIfExists: true),
                    [],
                    file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/vcf/test2.vcf.gz', checkIfExists: true),
                    file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/vcf/test2.vcf.gz.tbi', checkIfExists: true),
                    file("${projectDir}/modules/local/bcftools/annotate/tests/fixtures/headers.vcf", checkIfExists: true),
                    file("${projectDir}/modules/local/bcftools/annotate/tests/fixtures/rename_chrs.txt", checkIfExists: true)
                ]
                input[1] = "annotated"
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                // --rename-chrs must rewrite the MT192765.1 contig name to "renamed" in the output header
                { assert path(process.out.vcf.get(0).get(1)).LinesGzip.contains("##contig=<ID=renamed,length=29829>") },
                { assert snapshot(process.out.versions).match() }
            )
        }

    }

}
