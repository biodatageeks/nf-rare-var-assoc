nextflow_process {

    name "Test Process PREPARE_VCF (PB1)"
    script "../main.nf"
    process "PREPARE_VCF"

    tag "full"
    tag "modules"
    tag "modules/nextflow_run/prepare_vcf"

    // Runs the full nf-prepare-vcf child pipeline on the unprepared_rand_500 fixture.
    // The child pipeline does: BCFTOOLS_SORT -> BCFTOOLS_NORM (split multiallelics,
    // left-align and normalise against the reference FASTA) -> BCFTOOLS_ANNOTATE
    // (strip chr prefix, assign unique IDs) -> VEP_ANNOTATE (CSQ) ->
    // CALC_DOSAGE_POLARSBIO -> BCFTOOLS_REHEADER (adds DS FORMAT header).
    //
    // Fixture: assets/three_chr_unprepared/unprepared_rand_500.vcf.gz
    //   - 500 variants across chr12, chr22, chrX; 35 multiallelic sites
    //   - 3202 samples (1000G high-coverage, HG00096..NA21144)
    //
    // The reference FASTA and its .fai are the optional 3rd and 4th tuple elements
    // (--input_ref_fasta and the index staged next to it). Both are [] here, so the child
    // run downloads the reference itself from nf-prepare-vcf's default_ref_fasta_url --
    // which is what the pipeline does when --input_ref_fasta is not given.
    //
    // The child run is configured via prep.yml (compute_ld_report=false, publish_intermediate=true).
    // Container + resource settings are forwarded automatically via workflow.profile:
    //   the module passes -profile ${workflow.profile} to the child nextflow run.
    // publish_intermediate=true is mandatory: without it BCFTOOLS_NORM and
    // PLINK2_MAKEPGEN do not publish their tracking JSONs, so process.out.tracking
    // would be empty.
    //
    // Run with: nf-test test modules/local/nextflow_run/prepare_vcf/tests/main.nf.test
    //   (podman is the default profile in nf-test.config; no extra flags needed).
    //   child_podman.config is passed as add_config to cap process_high at 7 GB so
    //   PLINK2_MAKEPGEN (72 GB default in nf-prepare-vcf) fits on a dev machine.
    //
    // This test is tagged "full" because VEP annotation alone takes many minutes.
    // It does NOT run under CI (tag "ci" is intentionally absent).

    test("prepare_vcf on unprepared_rand_500: DS FORMAT + CSQ INFO in header, 3202 samples preserved, unique IDs, tracking from NORM") {

        when {
            params {
                cpu_support_avx2 = true
            }
            process {
                """
                input[0] = Channel.of(
                    tuple(
                        [ id: 'rand500' ],
                        file('${projectDir}/assets/three_chr_unprepared/unprepared_rand_500.vcf.gz', checkIfExists: true),
                        [],
                        [],
                        file('${projectDir}/modules/local/nextflow_run/prepare_vcf/assets/prep.yml', checkIfExists: true),
                        []
                    )
                )
                """
            }
        }

        then {
            assert process.success

            // ---- Read the output VCF once; derive all header + body checks from it ----
            def vcf_path = process.out.prepared_vcf[0][1]
            def vcf_lines = ["bash", "-c", "zcat ${vcf_path}"].execute().text.split('\n') as List

            // === Header invariants =================================================

            // DS FORMAT: added by BCFTOOLS_REHEADER after CALC_DOSAGE_POLARSBIO ran.
            // Absence means either REHEADER was skipped or CALC_DOSAGE_POLARSBIO failed.
            assert vcf_lines.any { it.startsWith('##FORMAT=<ID=DS') } :
                "output VCF must have ##FORMAT=<ID=DS,...> header line (added by BCFTOOLS_REHEADER)"

            // CSQ INFO: added by VEP_ANNOTATE. The downstream BCFTOOLS_ASSIGN_ANNOTATIONS
            // step parses CSQ by field *position*, so the Format field order is a contract,
            // not just decoration. Assert the leading fields it depends on are present and
            // in the expected order.
            def csq_header = vcf_lines.find { it.startsWith('##INFO=<ID=CSQ') }
            assert csq_header != null :
                "output VCF must have ##INFO=<ID=CSQ,...> header line (added by VEP_ANNOTATE)"
            assert csq_header.contains('Format: Allele|Consequence|IMPACT|SYMBOL|Gene|Feature_type|Feature|BIOTYPE') :
                "CSQ header Format must begin with the field order downstream parsing relies on; got: ${csq_header}"

            // Sample-count invariant: all 3202 input samples must be preserved.
            def header_line = vcf_lines.find { it.startsWith('#CHROM') }
            assert header_line != null : "output VCF must have a #CHROM header line"
            def sample_count = header_line.split('\t').size() - 9
            assert sample_count == 3202 :
                "expected 3202 samples in output VCF, got ${sample_count}"

            // === Per-record body invariants ========================================
            // Split each row but cap at 11 fields so we keep CHROM..sample1 (indices
            // 0-9) without splitting all 3202 sample columns (index 10 = the rest).
            // Columns: 0=CHROM 1=POS 2=ID 3=REF 4=ALT 5=QUAL 6=FILTER 7=INFO 8=FORMAT 9=sample1
            def data_lines = vcf_lines.findAll { it && !it.startsWith('#') }
            def rows = data_lines.collect { it.split('\t', 11) }

            // Record-count invariant: BCFTOOLS_NORM -m -any splits multiallelics (35
            // multiallelic sites in the fixture), so post-NORM count is >= 500.
            assert rows.size() >= 500 :
                "expected at least 500 variant records after normalization, got ${rows.size()}"

            // (1) Chromosome rename (BCFTOOLS_ANNOTATE + rename_chr.txt): the "chr" prefix
            //     must be stripped, and the fixture only spans chr12/chr22/chrX -> {12,22,X}.
            def chroms = rows.collect { it[0] }.toSet()
            assert chroms.every { !it.startsWith('chr') } :
                "all CHROM values must have the 'chr' prefix stripped (rename_chr.txt); got ${chroms}"
            assert chroms.every { it in ['12', '22', 'X'] } :
                "CHROM values must be a subset of the fixture's {12,22,X}; got ${chroms}"
            assert chroms.size() >= 2 :
                "expected multiple chromosomes carried through preparation; got ${chroms}"

            // (2) Multiallelic split (BCFTOOLS_NORM -m -any): every record must be biallelic.
            def multiallelic = rows.findAll { it[4].contains(',') }
            assert multiallelic.isEmpty() :
                "no record may carry a multiallelic ALT after NORM -m -any; offending: ${multiallelic.take(3).collect { it[2] }}"

            // (3) ID assignment (BCFTOOLS_ANNOTATE --set-id %CHROM_%POS_%REF_%ALT): each ID
            //     must reconstruct exactly from this record's own CHROM/POS/REF/ALT.
            def bad_ids = rows.findAll { it[2] != "${it[0]}_${it[1]}_${it[3]}_${it[4]}".toString() }
            assert bad_ids.isEmpty() :
                "every ID must equal CHROM_POS_REF_ALT; offending (id vs expected): " +
                "${bad_ids.take(3).collect { [it[2], "${it[0]}_${it[1]}_${it[3]}_${it[4]}"] }}"
            def ids = rows.collect { it[2] }
            assert ids.toSet().size() == ids.size() :
                "variant IDs must all be unique after --rm-dup + set-id (duplicates break plink write-snplist)"

            // (4) VEP annotation: every *annotatable* record must carry a non-empty CSQ
            //     value. Spanning-deletion star alleles (ALT='*'), which NORM -m -any emits
            //     when splitting a multiallelic site that overlaps an upstream deletion,
            //     are not annotatable by VEP and legitimately have no CSQ -- exclude them.
            def star_rows = rows.findAll { it[4] == '*' }
            def missing_csq = rows.findAll { row ->
                if (row[4] == '*') return false
                def csq = row[7].split(';').find { it.startsWith('CSQ=') }
                csq == null || csq.substring(4).trim().isEmpty()
            }
            assert missing_csq.isEmpty() :
                "every non-star (ALT!='*') record must carry a non-empty CSQ= INFO field; " +
                "offending: ${missing_csq.take(3).collect { it[2] }}"
            // And the split genuinely produced star alleles, proving NORM handled
            // deletion-overlapping multiallelics (33 such records on the fixture).
            assert !star_rows.isEmpty() :
                "expected some spanning-deletion star alleles (ALT='*') from NORM -m -any splitting"

            // (5) Dosage correctness (CALC_DOSAGE_POLARSBIO + BCFTOOLS_REHEADER).
            //     First, DS must be the last FORMAT key on every record.
            def bad_format = rows.findAll { it[8].split(':').last() != 'DS' }
            assert bad_format.isEmpty() :
                "every record's FORMAT must end with the DS key; offending: ${bad_format.take(3).collect { [it[2], it[8]] }}"

            // The dosage formula itself is deliberately NOT recomputed here. It used to be:
            // this test normalised each genotype's likelihoods across the genotypes the record
            // can express and required DS to match, which it did to ~1.5e-6 -- because that
            // formula *was* the implementation, a flat prior over the PL values. nf-prepare-vcf
            // now applies a Hardy-Weinberg prior to GATK-like PL, doses haploid (male chrX)
            // genotypes, and handles the PL that a multiallelic split leaves with no zero in it,
            // so the old formula is no longer the specification. Rewriting it under the new model
            // would put a second, untested copy of that model -- and of any misunderstanding of
            // it -- in a repository that only consumes the file. The formula is checked genotype
            // by genotype against an independently written implementation, on fixtures crafted to
            // reach every branch, in nf-prepare-vcf's own module suite
            // (modules/local/python/calc_dosage_polarsbio/tests/main.nf.test), and its pipeline
            // test asserts the same kind of properties as below on the same fixture.
            //
            // Measured when the new dosages first came through here, for the record: the old
            // flat-prior formula disagrees by 0.0016 per genotype on average, and the whole of
            // that sits in calls carrying almost no information -- the 97.6% of genotypes with
            // GQ > 40 differ by 1e-6, and DP>20 calls still round to their hard call 99.99% of
            // the time. Where the disagreement is largest the old formula is the wrong one: a
            // 0/0 call whose split-leftover PL is 143,42,28 was dosed at 1.96 alternative
            // alleles and is now dosed at 0.002.
            //
            // What follows asserts the properties this pipeline depends on when it hands the
            // file to PLINK2_EXPORT_OTHER / PLINK2_IMPORT_DOSAGE, plus the plausibility check
            // that dosage tracks read depth.
            int genotypesSeen = 0, dsPresent = 0
            int outOfRange = 0, haploidWithDs = 0, haploidUncertain = 0
            int confidentChecked = 0, confidentViolations = 0
            double confidentMaxDiff = 0.0
            double totalDs = 0.0
            int hardTotal = 0
            int singletonRecords = 0
            double singletonCarrierDs = 0.0, singletonNonCarrierDs = 0.0
            def rangeExamples = [], confidentExamples = []
            int hiDpTotal = 0, hiDpMatch = 0
            int inBetween = 0
            double inBetweenDpSum = 0.0
            int cleanInteger = 0
            double cleanIntegerDpSum = 0.0
            data_lines.each { line ->
                def cols = line.split('\t')
                def keys = cols[8].split(':') as List
                int gtIdx = keys.indexOf('GT')
                int dpIdx = keys.indexOf('DP')
                int dsIdx = keys.indexOf('DS')
                int plIdx = keys.indexOf('PL')
                if (dsIdx < 0 || plIdx < 0) return

                // The dosage prior is computed from the allele counts of the split records,
                // which the `bcftools +fill-tags` piped onto BCFTOOLS_NORM recomputes. Without
                // them CALC_DOSAGE cannot weight the likelihoods at all.
                def ac = cols[7].split(';').find { it.startsWith('AC=') }
                def an = cols[7].split(';').find { it.startsWith('AN=') }
                assert ac != null && an != null :
                    "every record must carry INFO/AC and INFO/AN for the dosage prior; " +
                    "${cols[2]} has AC=${ac} AN=${an}"
                int acValue = ac.substring(3).split(',')[0] as int
                boolean singleton = acValue == 1
                if (singleton) singletonRecords++

                for (int s = 9; s < cols.size(); s++) {
                    def sv = cols[s].split(':')
                    if (sv.size() <= Math.max(dsIdx, plIdx)) continue
                    genotypesSeen++
                    def gt = sv[gtIdx]
                    int ploidy = gt.count('/') + gt.count('|') + 1
                    if (!sv[dsIdx].isNumber()) continue        // DS only emitted for usable calls
                    double ds = sv[dsIdx] as double
                    dsPresent++
                    totalDs += ds
                    hardTotal += gt.count('1')

                    // DS is the expected number of alternative alleles, so a haploid genotype
                    // belongs in [0,1] and a diploid one in [0,2]. That scale is what keeps
                    // dosages and hard calls consistent downstream: plink2 reads the ploidy off
                    // GT and doubles a haploid dosage, exactly as it doubles a hemizygous call.
                    if (ds < 0.0 || ds > ploidy) {
                        outOfRange++
                        if (rangeExamples.size() < 5) rangeExamples <<
                            [pos: "${cols[0]}:${cols[1]}", gt: gt, ploidy: ploidy, ds: ds]
                    }
                    if (ploidy == 1) {
                        haploidWithDs++
                        if (ds > 0.0 && ds < 1.0) haploidUncertain++
                    }

                    // The one check on individual values, and it holds under any prior: when the
                    // likelihoods put a single genotype a million to one ahead of the rest (a PL
                    // gap of 60), no prior in a cohort this size can pull the dosage off that
                    // genotype's own allele count. Only where the likelihoods are the whole
                    // story, though -- a PL with no zero in it is what a multiallelic split
                    // leaves behind, and there the dosage deliberately follows GT instead.
                    def plParts = sv[plIdx].split(',')
                    if (plParts.every { it.isInteger() } && plParts.size() == ploidy + 1) {
                        def plInts = plParts.collect { it.toInteger() }
                        def ranked = plInts.sort(false)
                        if (ranked[0] == 0 && ranked[1] - ranked[0] >= 60) {
                            confidentChecked++
                            // The index of the smallest PL is that genotype's alt-allele count.
                            double diff = Math.abs(ds - plInts.indexOf(ranked[0]))
                            if (diff > confidentMaxDiff) confidentMaxDiff = diff
                            if (diff > 0.01) {
                                confidentViolations++
                                if (confidentExamples.size() < 5) confidentExamples <<
                                    [pos: "${cols[0]}:${cols[1]}", gt: gt, pl: sv[plIdx], ds: ds]
                            }
                        }
                    }

                    if (singleton) {
                        if (gt.contains('1')) singletonCarrierDs += ds
                        else singletonNonCarrierDs += ds
                    }

                    // ---- DP-vs-dosage plausibility ----
                    if (dpIdx >= 0 && dpIdx < sv.size() && sv[dpIdx].isNumber()) {
                        double dp = sv[dpIdx] as double
                        if (!gt.contains('.')) {                // skip missing genotypes
                            def alleles = gt.split('[/|]')      // post-split records are biallelic
                            if (alleles.every { it.isInteger() } && dp > 20) {
                                hiDpTotal++
                                if (Math.round(ds) == (long) alleles.collect { it.toInteger() }.sum()) hiDpMatch++
                            }
                        }
                        if (Math.abs(ds - Math.round(ds)) <= 0.1) { cleanInteger++; cleanIntegerDpSum += dp }
                        if ((ds >= 0.2 && ds <= 0.8) || (ds >= 1.2 && ds <= 1.8)) { inBetween++; inBetweenDpSum += dp }
                    }
                }
            }

            // Coverage: a genotype without a DS falls back to its hard call on import, so a
            // large gap would quietly replace dosages with rounded calls. 98.0% carry one here;
            // the rest are masked genotypes, calls below the child pipeline's GQ threshold, and
            // the split leftovers whose likelihoods say nothing about this record's ALT.
            assert dsPresent > 1000000 :
                "expected a dosage on most of the ~1.75M genotypes, got ${dsPresent}"
            assert dsPresent > 0.95 * genotypesSeen :
                "at least 95% of genotypes must carry a DS; got ${dsPresent} of ${genotypesSeen}"
            assert outOfRange == 0 :
                "every DS must lie in [0, ploidy] -- [0,1] for male chrX, [0,2] elsewhere; " +
                "${outOfRange} do not, e.g. ${rangeExamples}"

            // Most genotypes are confidently called, so this covers the great majority of the
            // file (1.62M of the 1.72M dosed here), and the observed worst case is 0.0012.
            assert confidentChecked > 1000000 :
                "expected most genotypes to be confidently called, only ${confidentChecked} have " +
                "a PL gap of 60 or more"
            assert confidentViolations == 0 :
                "a genotype whose likelihoods put one genotype a million to one ahead must be " +
                "dosed at that genotype's allele count; ${confidentViolations} of " +
                "${confidentChecked} are further than 0.01 away (worst ${confidentMaxDiff}), " +
                "e.g. ${confidentExamples}"

            // Over the file the dosages must still describe the calls they came from. Individual
            // dosages sit either side of their hard call, so the deviations cancel over 1.7M
            // genotypes and what is left is the prior's own shrinkage of weak carrier calls:
            // -0.63% here, against +3.7% before the multiallelic-split handling landed upstream.
            assert Math.abs(totalDs - hardTotal) < 0.01 * hardTotal :
                "the total dosage (${totalDs}) must be within 1% of the alternative alleles the " +
                "same genotypes were hard-called with (${hardTotal}); it is " +
                "${String.format(Locale.ROOT, '%+.3f', 100 * (totalDs - hardTotal) / hardTotal)}%"

            // Male chrX: the pipeline used to require three PL values and so left every haploid
            // genotype without a dosage, which this test never noticed because it only looked at
            // genotypes that had one. They must now be dosed, and genuinely computed.
            assert haploidWithDs > 100000 :
                "expected male chrX genotypes to be dosed on the haploid scale, only " +
                "${haploidWithDs} haploid genotypes carry a DS"
            assert haploidUncertain > 100 :
                "haploid dosages must be computed, not pinned to 0 or 1; only ${haploidUncertain} " +
                "of ${haploidWithDs} lie strictly between"

            // The allele-frequency prior is what removes the spurious dosage this pipeline's
            // burden tests used to add up: at a variant carried by a single allele in the cohort,
            // the ~3201 non-carriers must together hold almost none. Under the flat prior the
            // same fixture gives them 521 -- more than twice the carriers' own dosage.
            assert singletonRecords > 100 :
                "expected many AC=1 records in the fixture, got ${singletonRecords}"
            assert singletonNonCarrierDs < 5.0 :
                "non-carriers at AC=1 records must hold almost no dosage; got " +
                "${singletonNonCarrierDs} over ${singletonRecords} records (a value in the " +
                "hundreds means the child pipeline fell back to the flat prior -- check that " +
                "pl_type=auto resolved to 'likelihood' and that INFO/AC,AN reached CALC_DOSAGE)"
            assert singletonCarrierDs > 0.9 * singletonRecords :
                "carriers at AC=1 records must keep their dosage; got ${singletonCarrierDs} over " +
                "${singletonRecords} records"

            // Plausibility: dosage tracks read depth. Deep calls match the integer GT
            // dosage, and intermediate dosages are concentrated in shallow calls.
            assert hiDpTotal > 0 : "expected some deep (DP>20) genotypes to validate DS against"
            double hiDpMatchRate = hiDpMatch / (double) hiDpTotal
            assert hiDpMatchRate >= 0.999 :
                "at least 99.9% of DP>20 genotypes must have round(DS) == GT allele count; " +
                "match rate was ${hiDpMatchRate} (${hiDpMatch}/${hiDpTotal})"
            assert inBetween > 0 :
                "expected some intermediate-dosage genotypes (DS in [0.2,0.8] or [1.2,1.8])"
            assert cleanInteger > 0 : "expected clean integer-dosage genotypes to compare against"
            double inBetweenAvgDp = inBetweenDpSum / inBetween
            double cleanAvgDp = cleanIntegerDpSum / cleanInteger
            assert inBetweenAvgDp < cleanAvgDp * 0.5 :
                "intermediate-dosage genotypes must come from shallower calls than integer-dosage " +
                "ones; mean DP ${inBetweenAvgDp} over ${inBetween} entries vs ${cleanAvgDp} over " +
                "${cleanInteger} clean entries (expected < half)"

            // ---- prepared_vcf_tbi emit ----
            assert process.out.prepared_vcf_tbi[0][1].toString().endsWith('.tbi') :
                "prepared_vcf_tbi emit must carry a .tbi file"

            // === Tracking assertions ===============================================
            // With publish_intermediate=true, BCFTOOLS_NORM and PLINK2_MAKEPGEN each
            // publish a tracking JSON. The glob results/**/*tracking*.json must catch both.
            def tracking_raw = process.out.tracking[0]
            def tracking_list = (tracking_raw instanceof List) ? tracking_raw : [tracking_raw]
            assert tracking_list.size() >= 2 :
                "expected at least 2 tracking JSONs (NORM + MAKEPGEN), got ${tracking_list.size()}"

            // Find the NORM tracking JSON and validate its counts against the fixture.
            def norm_json_path = tracking_list.find { file(it).text.contains('BCFTOOLS_NORM') }
            assert norm_json_path != null :
                "expected a tracking JSON whose process_name contains BCFTOOLS_NORM"
            def norm_tracking = new groovy.json.JsonSlurper().parseText(file(norm_json_path).text)
            assert (norm_tracking.inputs.variants as int) == 500 :
                "NORM tracking.inputs.variants should equal input fixture count (500), got ${norm_tracking.inputs.variants}"
            assert (norm_tracking.inputs.samples as int) == 3202 :
                "NORM tracking.inputs.samples should be 3202, got ${norm_tracking.inputs.samples}"
            assert (norm_tracking.outputs.variants as int) >= 500 :
                "NORM tracking.outputs.variants should be >= 500 after multiallelic splitting, got ${norm_tracking.outputs.variants}"
            assert (norm_tracking.outputs.samples as int) == 3202 :
                "NORM tracking.outputs.samples should be 3202, got ${norm_tracking.outputs.samples}"

            // Body-vs-tracking cross-check: nothing between NORM and the final output
            // (ANNOTATE, VEP, CALC_DOSAGE, REHEADER) adds or drops records, so the output
            // record count must equal NORM's reported output variant count exactly.
            assert rows.size() == (norm_tracking.outputs.variants as int) :
                "output record count (${rows.size()}) must equal NORM tracking.outputs.variants " +
                "(${norm_tracking.outputs.variants}); a mismatch means a step silently changed the record set"
        }
    }

}
