// Passed as -c add_config to the child nf-prepare-vcf nextflow run.
// Podman is already enabled via profile forwarding (workflow.profile).
// This config caps process_high at 7 GB — the same limit as the low_resources
// profile — so PLINK2_MAKEPGEN (labeled process_high, 72 GB by default) fits
// on a development machine.
process {
    withLabel:process_high {
        cpus   = { 2 * task.attempt }
        memory = { 7.GB * task.attempt }
        time   = { 16.h * task.attempt }
    }
}
