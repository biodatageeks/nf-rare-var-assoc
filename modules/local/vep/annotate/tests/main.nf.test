nextflow_process {

    name "Test Process VEP_ANNOTATE"
    script "../main.nf"
    process "VEP_ANNOTATE"

    // Tagged "full": the test requires ${projectDir}/../vep_cachedir which is a
    // machine-local cache (~30 GB) and is not portable. CI skips "full" tests.
    tag "full"
    tag "modules"
    tag "vep_annotate"

    test("1000g_lpa - vcf - vep annotations added") {

        when {
            process {
                """
                // vep_cache is now the 4th element of the consolidated input tuple
                // (signature: tuple(meta, input_vcf, input_vcf_tbi, vep_cache) + 3 vals).
                // input_vcf is plain-text VCF (no tbi); pass [] for input_vcf_tbi.
                input[0] = [
                    [ id:'test', single_end:false ],
                    file('${projectDir}/assets/medium_data/1000g_lpa_hg38.vcf', checkIfExists: true),
                    [],
                    file('${projectDir}/../vep_cachedir/homo_sapiens_refseq', checkIfExists: true)
                ]
                input[1] = 'homo_sapiens'
                input[2] = '113_GRCh38/Homo_sapiens.GRCh38.dna.toplevel.fa.gz'
                input[3] = '--offline --no_stats --refseq --use_given_ref --exclude_predicted --compress_output bgzip --vcf --numbers --protein --total_length --force_overwrite --format vcf --regulatory --variant_class --symbol --biotype --distance 5000 --canonical --pubmed --mane'
                """
            }
        }

        then {
            assert process.success

            // The CSQ INFO field must appear in the VCF header — confirms VEP ran and
            // wrote annotations (as opposed to producing an empty or unformatted output).
            def vcfLines = path(process.out.vcf[0][1]).linesGzip
            assert vcfLines.any { it.contains('##INFO=<ID=CSQ') } :
                "VEP output VCF must contain a ##INFO=<ID=CSQ,...> header line"

            // At least one data record must carry a populated CSQ annotation.
            assert vcfLines.findAll { !it.startsWith('#') }.any { it.contains('CSQ=') } :
                "At least one variant in VEP output must carry a non-empty CSQ= annotation"

            assert snapshot(process.out.versions).match()
        }

    }

}
