/*
========================================================================================
    IT-6 config: full RARE_VAR_ASSOC workflow, fast path
    (skip_preparation=true, skip_reporting=true, use_dosage=true).

    Mirrors conf/test_skip_preparation_and_reporting.config but feeds the inputs through
    the test's input channels instead of params. The input VCF is the CSQ-annotated
    medium_data 3-chromosome fixture (the fast path requires a VEP-annotated input
    because VEP_ANNOTATE only runs when skip_preparation=false).
========================================================================================
*/

process {
    resourceLimits = [
        cpus: 4,
        memory: '15.GB',
        time: '6.h'
    ]
}

params {
    use_dosage       = true
    skip_preparation = true
    skip_reporting   = true

    // The fixture exposes plain AF in INFO (not AF_nfe_gnomad); use AF for the dosage AAF.
    rscript_vcf2aaf_options = 'AF AF'

    // Float tolerance (~4 decimal places) for the Regenie step-2 reference-output
    // comparison (see the test).
    regenie_reference_tol = 1.0e-4
}
