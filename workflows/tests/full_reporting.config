/*
========================================================================================
    IT-7 config: full RARE_VAR_ASSOC workflow, reporting path
    (skip_preparation=false, skip_reporting=false, use_dosage=false).

    Input VCF: assets/three_chr_unprepared/unprepared_rand_500.vcf.gz (raw, 3 chr, 3202
    samples). The pipeline runs NORM -> ANNOTATE -> VEP -> FILTER -> plink2 -> Regenie ->
    REPORTING. Tag "full" -- nightly only, not CI.
========================================================================================
*/

process {
    resourceLimits = [
        cpus: 4,
        memory: '15.GB',
        time: '6.h'
    ]
}

params {
    use_dosage       = false
    skip_preparation = false
    skip_reporting   = false

    // The fixture exposes plain AF in INFO; use it for the AAF file.
    rscript_vcf2aaf_options = 'AF AF'

    // Looser Regenie thresholds so the small 500-variant fixture gets through step 1.
    //regenie_step1_options = '--minCaseCount 1 --minMAC 1 --bt --bsize 100 --lowmem'
    //regenie_step2_options = '--minCaseCount 1 --minMAC 1 --bt --ref-first --firth --approx --bsize 200 --lowmem --aaf-bins 0.01,0.05,0.1,1 --write-mask --write-mask-snplist --vc-tests skato'
}
