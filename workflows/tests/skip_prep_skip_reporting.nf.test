nextflow_workflow {

    name "Test Workflow RARE_VAR_ASSOC -- fast path (IT-6)"
    script "../rare-var-assoc.nf"
    workflow "RARE_VAR_ASSOC"

    tag "ci"
    tag "workflows"
    tag "workflows/rare_var_assoc"

    // IT-6: the parameter-optimization fast path (skip_preparation + skip_reporting +
    // use_dosage). Runs the whole association pipeline end-to-end on a CSQ-annotated
    // 3-chromosome fixture and one binary phenotype (Y1), then independently re-derives a
    // naive per-variant signal for the genes Regenie ranks highest. See
    // docs/test-quality-and-cleanup/integration-tests.md for the assertion design.
    //
    // Input fixture choice: the fast path SKIPS VEP (VEP_ANNOTATE only runs when
    // skip_preparation=false), so the input VCF must already carry CSQ. The committed
    // prepared_500 VCF does not (PREPARE never runs VEP), so this test uses the
    // CSQ-annotated medium_data fixture -- the same input shape the production fast-path
    // config (conf/test_skip_preparation_and_reporting.config) feeds. 4955 variants /
    // 3202 samples; the whole pipeline finishes well inside the 5-min CI budget.
    //
    // Fixtures (assets/three_chr_unprepared/):
    //   pheno_binary.tsv  - FID IID Y1 ; controls=0 (2000), cases=1 (1202). Mirrors the
    //                       RSCRIPT_BUILD_PHENOTYPES output that production feeds Regenie.
    //   all_samples.txt   - cases ++ controls (3202 IDs); the BCFTOOLS_VIEW_AND_FILTER2
    //                       --samples-file on the skip_preparation branch.
    //   cases.txt / controls.txt - reused by the naive-LOG10P helper.

    config "./skip_prep_skip_reporting.config"

    test("fast path: pipeline completes and Regenie's top genes carry a corroborating naive signal") {

        when {
            params {
                outdir = "$outputDir"
            }
            workflow {
                """
                input[0] = Channel.of(
                    tuple(
                        [ id:'test' ],
                        file('${projectDir}/assets/medium_data/prepared_chr_12_22_X_csq_filtered_2k_rand_3k.vcf.gz', checkIfExists: true)
                    )
                )
                input[1] = Channel.of(
                    tuple(
                        [ id:'test' ],
                        file('${projectDir}/assets/three_chr_unprepared/pheno_binary.tsv', checkIfExists: true)
                    )
                )
                input[2] = Channel.of(
                    tuple(
                        [ id:'test' ],
                        file('${projectDir}/assets/three_chr_unprepared/all_samples.txt', checkIfExists: true)
                    )
                )
                """
            }
        }

        then {
            assert workflow.success

            // ---- Regenie step 1: one LOCO manifest + one LOCO file for the single pheno ----
            assert workflow.out.regenie_step1_pred_list.size() == 1
            def pred_list = path(workflow.out.regenie_step1_pred_list[0][1])
            assert pred_list.toString().endsWith('_pred.list')
            // The manifest names the phenotype and points at its LOCO file.
            def pred_first = pred_list.readLines()[0].split(/\s+/)
            assert pred_first[0] == 'Y1' :
                "pred.list must reference phenotype Y1, got '${pred_first[0]}'"
            assert workflow.out.regenie_step1_loco.size() == 1
            def loco = workflow.out.regenie_step1_loco[0][1]
            assert loco.toString().endsWith('.loco') :
                "expected a single .loco file, got ${loco}"

            // ---- Regenie step 2: one uncompressed *_Y1.regenie covering all chromosomes ----
            def regenie = path(workflow.out.regenie_step2_out[0][1])
            assert regenie.toString().endsWith('_Y1.regenie') :
                "expected step2 output ending in _Y1.regenie, got ${regenie}"
            def data_lines = regenie.readLines().findAll { it && !it.startsWith('##') }
            def header = data_lines[0].split(/\s+/) as List
            assert header == ['CHROM','GENPOS','ID','ALLELE0','ALLELE1','A1FREQ','N','TEST','BETA','SE','CHISQ','LOG10P','EXTRA'] :
                "unexpected regenie column header: ${header}"
            // All three input chromosomes must be represented (no --chr split): the single
            // step2 output spans 12, 22 and X (plink2/regenie code chrX numerically as 23).
            // A wiring bug that dropped a chromosome from the step2 VCF/pgen surfaces here.
            def id_i = header.indexOf('ID')
            def chroms = data_lines.drop(1).collect { it.split(/\s+/)[0] } as Set
            assert ['12','22','23'].every { it in chroms } :
                "expected chromosomes 12/22/23(=X) in regenie output, got ${chroms}"
            // Output is gene-burden set rows (GENE.MASK.AAF), not single variants.
            assert data_lines.drop(1).any { it.split(/\s+/)[id_i].contains('.Mask_') } :
                "regenie output should contain gene.mask burden rows"

            // ---- MultiQC + tracking report present ----
            assert file("${params.outdir}/multiqc/multiqc_report.html").exists() :
                "expected a MultiQC report under ${params.outdir}/multiqc/"
            def tracking_html = file("${params.outdir}/generate_tracking_report").listFiles()
                .findAll { it.name.endsWith('_sankey_report.html') }
            assert tracking_html.size() == 1 :
                "expected one tracking sankey report under generate_tracking_report/, got ${tracking_html}"

            // ---- Statistical-soundness check (the load-bearing assertion) ----
            // For the genes Regenie ranks highest, a deliberately naive single-variant
            // chi-square on the raw genotypes (recomputed from the input VCF + the
            // pipeline's own setlist/annotations) should also point at those genes.
            // Burden-only signal (e.g. SKAT/SKATO aggregating many sub-threshold variants)
            // legitimately exceeds any single variant, so the helper tolerates up to 2 of
            // the 5 top genes diverging; >=3 divergences means Regenie is highlighting genes
            // whose raw genotype distribution is statistically flat -- a wiring regression.
            //
            // Expected output on the current fixture (helper prints this table; floor=0.5,
            // tol=2.0, max_violations=3 -> 1/5 violated -> PASS):
            //
            //   GENE            MASK           REGENIE     NAIVE  NVAR NUSED  VERDICT
            //   HIP1R           Mask_Mod         7.103     6.637     4     4  ok
            //   POLE            Mask_HighMod     6.264     2.739    11    11  VIOLATION
            //   C12orf56        Mask_Mod         5.045     4.795     3     3  ok
            //   ABCB9           Mask_Mod         4.058     3.973     1     1  ok
            //   NINJ2           Mask_Mod         3.913     3.754     3     3  ok
            //
            // Four of five top genes agree with Regenie within ~0.5 log units. POLE is the
            // expected, tolerated VIOLATION: its winning row is POLE.Mask_HighMod.0.1 (an ADD
            // *burden* over the rare AAF<=0.1 variants, A1FREQ=0.023). No single POLE variant
            // reaches LOG10P 6.26 -- the strongest is 12_132635899_C_T (missense, AAF 0.011),
            // case [1190 hom-ref, 12 het, 0 hom-alt] vs ctrl [1943, 54, 3], naive -log10p
            // 2.739; a second rare one 12_132681251_C_A (AAF 0.010, case [1188,13,1] vs ctrl
            // [1951,48,1]) is concordantly control-enriched. Regenie reaches 6.26 by summing
            // these rare-variant dosages and adjusting for PC covariates + Firth, which a
            // single-variant test structurally cannot reproduce. (The common variant
            // 12_132643940_T_C, AAF 0.118, is excluded from the 0.1 AAF bin Regenie used.)
            // This burden-vs-single-variant gap is exactly what the tolerance absorbs.
            def setlist = workflow.out.setlist[0][1]
            def annotations = workflow.out.annotations[0][1]
            def helper = "${projectDir}/workflows/tests/helpers/recompute_naive_log10p.py"
            def cmd = [
                'podman', 'run', '--rm',
                '-v', "${projectDir}:${projectDir}",
                '-w', "${projectDir}",
                'docker.io/psuszynski/bioinf_combo:1.5.1',
                'python3', helper.toString(),
                '--regenie', regenie.toString(),
                '--vcf', "${projectDir}/assets/medium_data/prepared_chr_12_22_X_csq_filtered_2k_rand_3k.vcf.gz",
                '--setlist', setlist.toString(),
                '--annotations', annotations.toString(),
                '--masks', "${projectDir}/assets/default.masks",
                '--cases', "${projectDir}/assets/three_chr_unprepared/cases.txt",
                '--controls', "${projectDir}/assets/three_chr_unprepared/controls.txt",
                '--top-n', '5', '--floor', '0.5', '--tol', '2.0', '--max-violations', '3'
            ]
            def sout = new StringBuilder()
            def serr = new StringBuilder()
            def proc = cmd.execute()
            proc.consumeProcessOutput(sout, serr)
            proc.waitFor()
            println "naive-LOG10P check stdout:\n${sout}"
            if (serr.length() > 0) println "naive-LOG10P check stderr:\n${serr}"
            assert proc.exitValue() == 0 :
                "naive-LOG10P soundness check failed (Regenie's top genes lack a corroborating raw-genotype signal):\n${sout}\n${serr}"

            // ---- Reference-output comparison ----
            // Field-by-field comparison of the produced step-2 output against the committed
            // reference, with floats compared within regenie_reference_tol (~4 dp) and all
            // non-numeric tokens compared exactly. Regenie is deterministic on this fixture.
            def tol = (params.regenie_reference_tol ?: 1.0e-4) as double
            def refFile = file("${projectDir}/workflows/tests/fixtures/expected_step2_Y1.regenie")
            assert refFile.exists() : "reference output missing: ${refFile} (regenerate it)"

            // Parse a regenie file into {meta ## lines, header, rows keyed by (ID,TEST)}.
            def parse = { List<String> ls ->
                def meta = ls.findAll { it.startsWith('##') }
                def body = ls.findAll { it && !it.startsWith('##') }
                def hdr = body[0].split(/\s+/) as List
                def idI = hdr.indexOf('ID')
                def testI = hdr.indexOf('TEST')
                def rows = [:]
                body.drop(1).each { line ->
                    def f = line.split(/\s+/) as List
                    rows[[f[idI], f[testI]]] = f
                }
                [meta: meta, hdr: hdr, rows: rows]
            }
            def ref = parse(refFile.readLines())
            def got = parse(regenie.readLines())

            assert got.meta == ref.meta :
                "##MASKS metadata diverged from reference:\nref: ${ref.meta}\ngot: ${got.meta}"
            assert got.hdr == ref.hdr :
                "column header diverged from reference:\nref: ${ref.hdr}\ngot: ${got.hdr}"
            def missing = (ref.rows.keySet() - got.rows.keySet()) as List
            def extra = (got.rows.keySet() - ref.rows.keySet()) as List
            assert missing.isEmpty() :
                "${missing.size()} (ID,TEST) rows in reference are missing from output, e.g. ${missing.take(10)}"
            assert extra.isEmpty() :
                "${extra.size()} (ID,TEST) rows in output are absent from reference, e.g. ${extra.take(10)}"

            def diffs = []
            ref.rows.each { key, rf ->
                def gf = got.rows[key]
                if (gf.size() != rf.size()) {
                    diffs << "${key}: field count ref=${rf.size()} got=${gf.size()}"
                    return
                }
                rf.eachWithIndex { rv, i ->
                    def gv = gf[i]
                    if (rv.isDouble() && gv.isDouble()) {
                        def d = Math.abs(rv.toDouble() - gv.toDouble())
                        if (d > tol)
                            diffs << "${key} '${ref.hdr[i]}': ref=${rv} got=${gv} (|d|=${d})"
                    } else if (rv != gv) {
                        diffs << "${key} '${ref.hdr[i]}': ref='${rv}' got='${gv}'"
                    }
                }
            }
            assert diffs.isEmpty() :
                "regenie output diverges from reference beyond tol=${tol} (${diffs.size()} field diffs):\n" +
                diffs.take(20).join('\n')
        }
    }

}
